<UserControl x:Class="PharmaPOS.WPF.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:invVm="clr-namespace:PharmaPOS.WPF.ViewModels.Inventory"
             d:DataContext="{d:DesignInstance Type=invVm:InventoryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700">
    <UserControl.Resources>
        <Style x:Key="InvDataGrid" TargetType="DataGrid" BasedOn="{StaticResource PharmaDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="26" />
            <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="5,1" />
        </Style>
        <Style x:Key="InvReadOnlyGrid" TargetType="DataGrid" BasedOn="{StaticResource InvDataGrid}">
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style x:Key="InvOutlinedBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MaxHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        </Style>
        <Style x:Key="InvOutlinedCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MaxHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        </Style>
        <Style x:Key="InvToolbarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- ~50 characters at 12.5pt; ellipsis + tooltip for longer names. -->
        <Style x:Key="MedicineNameCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding MedicineName}" />
        </Style>
        <Style x:Key="KpiChip" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <materialDesign:Card UniformCornerRadius="8" Padding="8,6"
                             materialDesign:ElevationAssist.Elevation="Dp1">
            <DockPanel>
                <TabControl SelectedIndex="{Binding SelectedTab}" Style="{StaticResource HeaderlessTabControl}">
                    <!-- STOCK ON HAND -->
                    <TabItem Header="On Hand" Padding="8,2">
                        <Grid DataContext="{Binding StockOnHand}" Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- KPI + search/actions on one compact block -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,4">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <Border Style="{StaticResource KpiChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Medicines" FontSize="11" Opacity="0.55" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Summary.TotalMedicines}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource KpiChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Qty" FontSize="11" Opacity="0.55" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Summary.TotalQuantity, StringFormat=N0}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource KpiChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Value" FontSize="11" Opacity="0.55" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Summary.StockValue, Converter={StaticResource Currency}}"
                                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource KpiChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Alerts" FontSize="11" Opacity="0.55" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding AlertsSummaryText, Mode=OneWay}"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="Search :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBox Width="240" MaxLength="50"
                                                 materialDesign:HintAssist.Hint="Search medicine, batch, barcode..."
                                                 materialDesign:HintAssist.IsFloating="False"
                                                 Style="{StaticResource InvOutlinedBox}"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="Filter :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <ComboBox Width="130"
                                                  ItemsSource="{Binding FilterOptions}"
                                                  SelectedItem="{Binding SelectedFilter}"
                                                  DisplayMemberPath="Label"
                                                  materialDesign:HintAssist.Hint="Filter"
                                                  materialDesign:HintAssist.IsFloating="False"
                                                  Style="{StaticResource InvOutlinedCombo}" />
                                    </StackPanel>
                                    <Button Command="{Binding ScanBarcodeCameraCommand}"
                                            Style="{StaticResource InvToolbarButton}"
                                            ToolTip="Scan barcode with camera">
                                        <materialDesign:PackIcon Kind="BarcodeScan" Width="14" Height="14" />
                                    </Button>
                                    <Button Command="{Binding DataContext.ViewLedgerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{StaticResource InvToolbarButton}"
                                            ToolTip="View ledger for selected batch">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="14" Height="14" VerticalAlignment="Center" />
                                            <TextBlock Text="Ledger" Margin="4,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RefreshCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="28" Height="28" ToolTip="Refresh stock on hand">
                                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <DataGrid Grid.Row="1" Style="{StaticResource InvReadOnlyGrid}"
                                      ItemsSource="{Binding Items}"
                                      SelectedItem="{Binding SelectedItem}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}"
                                                        Width="375" MinWidth="120" MaxWidth="375"
                                                        ElementStyle="{StaticResource MedicineNameCell}" />
                                    <DataGridTextColumn Header="Generic" Binding="{Binding GenericName}" Width="*" MinWidth="100" />
                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="85" />
                                    <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryLabel}" Width="72" />
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityAvailable}" Width="55" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding MedicineTotalQty}" Width="55" />
                                    <DataGridTextColumn Header="Cost" Binding="{Binding PurchasePrice, StringFormat=N2}" Width="70" />
                                    <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}" Width="70" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding StockValue, StringFormat=N2}" Width="75" />
                                    <DataGridTextColumn Header="Rack / bin" Binding="{Binding LocationLabel}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- STOCK LEDGER -->
                    <TabItem Header="Ledger" Padding="8,2">
                        <Grid DataContext="{Binding StockLedger}" Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Search :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBox Width="240" MaxLength="50"
                                             materialDesign:HintAssist.Hint="Search medicine or reference..."
                                             materialDesign:HintAssist.IsFloating="False"
                                             Style="{StaticResource InvOutlinedBox}"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock Text="{Binding FilterLabel}" FontSize="11" Opacity="0.55"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding FilterLabel, Converter={StaticResource StringToVisibility}}" />
                                <Button Command="{Binding ClearFilterCommand}"
                                        Style="{StaticResource InvToolbarButton}"
                                        Visibility="{Binding HasFilter, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Clear" />
                                </Button>
                                <Button Command="{Binding RefreshCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28"
                                        ToolTip="Refresh">
                                    <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
                                </Button>
                            </WrapPanel>

                            <DataGrid Grid.Row="1" Style="{StaticResource InvReadOnlyGrid}" ItemsSource="{Binding Items}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding MovementDateLabel}" Width="130" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding MovementTypeLabel}" Width="100" />
                                    <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}"
                                                        Width="375" MinWidth="120" MaxWidth="375"
                                                        ElementStyle="{StaticResource MedicineNameCell}" />
                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="80" />
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="55" />
                                    <DataGridTextColumn Header="Balance" Binding="{Binding BalanceAfter}" Width="55" />
                                    <DataGridTextColumn Header="Ref" Binding="{Binding ReferenceNumber}" Width="115" />
                                    <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*" MinWidth="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- STOCK ADJUSTMENT -->
                    <TabItem Header="Adjustment" Padding="8,2"
                             Visibility="{Binding CanAdjustStock, Converter={StaticResource BoolToVisibility}}">
                        <Grid DataContext="{Binding StockAdjustment}" Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center"
                                       ToolTip="Enter physical counts and save to adjust stock.">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Adjustment # :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBox Width="130" IsReadOnly="True"
                                             materialDesign:HintAssist.Hint="Adjustment #"
                                             materialDesign:HintAssist.IsFloating="False"
                                             Style="{StaticResource InvOutlinedBox}"
                                             Text="{Binding AdjustmentNumber, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Date :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <DatePicker Width="120" VerticalAlignment="Center"
                                                materialDesign:HintAssist.Hint="Date"
                                                materialDesign:HintAssist.IsFloating="False"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                                SelectedDate="{Binding AdjustmentDate}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Reason :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBox Width="220"
                                             materialDesign:HintAssist.Hint="Reason"
                                             materialDesign:HintAssist.IsFloating="False"
                                             Style="{StaticResource InvOutlinedBox}"
                                             Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <Button Command="{Binding NewCommand}" Style="{StaticResource InvToolbarButton}">
                                    <TextBlock Text="New" />
                                </Button>
                                <Button Command="{Binding AddLineCommand}" Style="{StaticResource InvToolbarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="Add" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SaveCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="10,2" Height="28">
                                    <TextBlock Text="Save" FontSize="12" />
                                </Button>
                            </WrapPanel>

                            <DataGrid Grid.Row="1" Style="{StaticResource InvDataGrid}"
                                      ItemsSource="{Binding Lines}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}"
                                                        Width="375" MinWidth="120" MaxWidth="375" IsReadOnly="True"
                                                        ElementStyle="{StaticResource MedicineNameCell}" />
                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="85" IsReadOnly="True" />
                                    <DataGridTextColumn Header="System" Binding="{Binding SystemQuantity}" Width="65" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Physical" IsReadOnly="False"
                                                        Binding="{Binding PhysicalQuantity, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <DataGridTextColumn Header="Diff" Binding="{Binding Difference}" Width="55" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Remarks" IsReadOnly="False"
                                                        Binding="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="100" />
                                    <DataGridTemplateColumn Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="28" Height="28"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remove">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- BRANCH TRANSFER (create / send) -->
                    <TabItem Header="Transfer" Padding="8,2"
                             Visibility="{Binding CanTransferStock, Converter={StaticResource BoolToVisibility}}">
                        <Grid DataContext="{Binding StockTransfer}" Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center"
                                       ToolTip="Each store keeps its own DB. Send creates a .pharmatrf file — the other store uses Import. Partner stores: Settings → Branches (same Code on both PCs).">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Transfer # :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBox Width="130" IsReadOnly="True"
                                             materialDesign:HintAssist.Hint="Transfer #"
                                             materialDesign:HintAssist.IsFloating="False"
                                             Style="{StaticResource InvOutlinedBox}"
                                             Text="{Binding TransferNumber, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Date :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <DatePicker Width="120" VerticalAlignment="Center"
                                                materialDesign:HintAssist.Hint="Date"
                                                materialDesign:HintAssist.IsFloating="False"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                                SelectedDate="{Binding TransferDate}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="To store :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <ComboBox Width="180"
                                              Style="{StaticResource InvOutlinedCombo}"
                                              materialDesign:HintAssist.Hint="To store"
                                              materialDesign:HintAssist.IsFloating="False"
                                              ItemsSource="{Binding DestinationBranches}"
                                              SelectedItem="{Binding SelectedDestination}"
                                              DisplayMemberPath="Name" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Remarks :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBox Width="180"
                                             materialDesign:HintAssist.Hint="Remarks (optional)"
                                             materialDesign:HintAssist.IsFloating="False"
                                             Style="{StaticResource InvOutlinedBox}"
                                             Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <Button Command="{Binding ImportCommand}" Style="{StaticResource InvToolbarButton}"
                                        ToolTip="Import .pharmatrf package from another store">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileImportOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="Import" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding NewCommand}" Style="{StaticResource InvToolbarButton}">
                                    <TextBlock Text="New" />
                                </Button>
                                <Button Command="{Binding AddLineCommand}" Style="{StaticResource InvToolbarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="Add" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SaveCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="10,2" Height="28">
                                    <TextBlock Text="Send + export" FontSize="12" />
                                </Button>
                            </WrapPanel>

                            <DataGrid Grid.Row="1" Style="{StaticResource InvDataGrid}"
                                      ItemsSource="{Binding Lines}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}"
                                                        Width="375" MinWidth="120" MaxWidth="375" IsReadOnly="True"
                                                        ElementStyle="{StaticResource MedicineNameCell}" />
                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="85" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDisplay}" Width="70" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Available" Binding="{Binding AvailableQuantity}" Width="75" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Transfer qty" IsReadOnly="False"
                                                        Binding="{Binding TransferQuantity, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                    <DataGridTemplateColumn Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="28" Height="28"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remove">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2" Margin="0,4,0,0" FontSize="11" Opacity="0.7" Text="{Binding StatusMessage}" />
                        </Grid>
                    </TabItem>

                    <!-- RECENT TRANSFERS (history + lines side by side) -->
                    <TabItem Header="Recent Transfer" Padding="8,2"
                             Visibility="{Binding CanTransferStock, Converter={StaticResource BoolToVisibility}}">
                        <Grid DataContext="{Binding StockTransfer}" Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="Recent transfers" FontSize="11" Opacity="0.55"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Command="{Binding CancelCommand}" Style="{StaticResource InvToolbarButton}"
                                        ToolTip="Cancel selected sent package and restore stock">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Undo" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="Cancel" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ReExportCommand}" Style="{StaticResource InvToolbarButton}"
                                        ToolTip="Re-export selected sent package">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Export" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="Re-export" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RefreshHistoryCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28"
                                        ToolTip="Refresh history">
                                    <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
                                </Button>
                            </WrapPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="280" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" MinWidth="280" />
                                </Grid.ColumnDefinitions>

                                <DataGrid Grid.Column="0" Style="{StaticResource InvReadOnlyGrid}"
                                          ItemsSource="{Binding RecentTransfers}"
                                          SelectedItem="{Binding SelectedHistoryRow}"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Transfer #" Binding="{Binding TransferNumber}" Width="120" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding TransferDate, StringFormat=dd-MMM-yyyy}" Width="95" />
                                        <DataGridTextColumn Header="From" Binding="{Binding FromBranchName}" Width="*" MinWidth="80" />
                                        <DataGridTextColumn Header="To" Binding="{Binding ToBranchName}" Width="*" MinWidth="80" />
                                        <DataGridTextColumn Header="Lines" Binding="{Binding LineCount}" Width="50" />
                                        <DataGridTextColumn Header="Qty" Binding="{Binding TotalQuantity}" Width="50" />
                                        <DataGridTextColumn Header="Dir" Binding="{Binding DirectionLabel}" Width="70" />
                                        <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*" MinWidth="60" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                              Background="{DynamicResource MaterialDesignDivider}" />

                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,2"
                                               FontSize="11" Opacity="0.55"
                                               Text="{Binding SelectedTransferSummary, TargetNullValue=Select a transfer to see medicines,
                                                              FallbackValue=Select a transfer to see medicines}"
                                               TextTrimming="CharacterEllipsis" />
                                    <DataGrid Style="{StaticResource InvReadOnlyGrid}"
                                              ItemsSource="{Binding SelectedTransferLines}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}"
                                                                Width="375" MinWidth="120" MaxWidth="375"
                                                                ElementStyle="{StaticResource MedicineNameCell}" />
                                            <DataGridTextColumn Header="Barcode" Binding="{Binding MedicineBarcode}" Width="110" />
                                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="90" />
                                            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDisplay}" Width="70" />
                                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="60" />
                                            <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}" Width="70" />
                                            <DataGridTextColumn Header="P.Rate" Binding="{Binding PurchasePrice, StringFormat=N2}" Width="70" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- SHORTAGE BOOK -->
                    <TabItem Header="Shortage book" Padding="8,2">
                        <Grid DataContext="{Binding ShortageBook}" Margin="0,2,0,0"
                              ToolTip="Lost sales when stock was unavailable. Use with Purchase Order → Generate reorder / From shortage book.">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Search :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBox Width="220" MaxLength="50"
                                             Style="{StaticResource InvOutlinedBox}"
                                             materialDesign:HintAssist.Hint="Search medicine / customer"
                                             materialDesign:HintAssist.IsFloating="False"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Filter :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <ComboBox Width="130"
                                              Style="{StaticResource InvOutlinedCombo}"
                                              ItemsSource="{Binding FilterOptions}"
                                              SelectedItem="{Binding SelectedFilter}"
                                              DisplayMemberPath="Label"
                                              materialDesign:HintAssist.Hint="Filter"
                                              materialDesign:HintAssist.IsFloating="False" />
                                </StackPanel>
                                <Button Command="{Binding RecordManualCommand}" Style="{StaticResource InvToolbarButton}"
                                        ToolTip="Manually record a shortage">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="Record" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CancelEntryCommand}" Style="{StaticResource InvToolbarButton}"
                                        ToolTip="Cancel selected open/ordered entry">
                                    <TextBlock Text="Cancel" />
                                </Button>
                                <Button Command="{Binding DeleteEntryCommand}" Style="{StaticResource InvToolbarButton}"
                                        ToolTip="Delete selected shortage row from the book">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="Delete" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RefreshCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28"
                                        ToolTip="Refresh">
                                    <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
                                </Button>
                            </WrapPanel>

                            <DataGrid Grid.Row="1" Style="{StaticResource InvReadOnlyGrid}"
                                      ItemsSource="{Binding Items}"
                                      SelectedItem="{Binding SelectedItem}"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="When" Binding="{Binding RecordedAtLabel}" Width="140" />
                                    <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}"
                                                        Width="375" MinWidth="120" MaxWidth="375"
                                                        ElementStyle="{StaticResource MedicineNameCell}" />
                                    <DataGridTextColumn Header="Wanted" Binding="{Binding RequestedQuantity, StringFormat=0.##}" Width="70" />
                                    <DataGridTextColumn Header="Had" Binding="{Binding AvailableQuantity, StringFormat=0.##}" Width="60" />
                                    <DataGridTextColumn Header="Short" Binding="{Binding ShortfallQuantity, StringFormat=0.##}" Width="60" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="80" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding SourceLabel}" Width="80" />
                                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" MinWidth="100" />
                                    <DataGridTextColumn Header="PO" Binding="{Binding PurchaseOrderNumber}" Width="110" />
                                    <DataGridTextColumn Header="By" Binding="{Binding RecordedBy}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2" Margin="0,4,0,0" FontSize="11" Opacity="0.7" Text="{Binding StatusMessage}" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
