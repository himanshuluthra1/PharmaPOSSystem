<Window x:Class="PharmaPOS.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:PharmaPOS.WPF.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Title="PharmaPOS" Height="768" Width="1280"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="/Assets/app.ico"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top app bar -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid"
                                  materialDesign:ElevationAssist.Elevation="Dp4"
                                  Padding="16,8">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                                      ToolTip="Toggle dark / light theme"
                                      IsChecked="{Binding IsDarkMode}"
                                      Margin="4,0">
                            <materialDesign:PackIcon Kind="WeatherNight" />
                            <materialDesign:ToggleButtonAssist.OnContent>
                                <materialDesign:PackIcon Kind="WhiteBalanceSunny" />
                            </materialDesign:ToggleButtonAssist.OnContent>
                        </ToggleButton>

                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Notifications">
                            <materialDesign:PackIcon Kind="BellOutline" />
                        </Button>

                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountCircle" Width="28" Height="28"
                                                     VerticalAlignment="Center" />
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                <TextBlock Text="{Binding RoleName}" FontSize="11" Opacity="0.8"
                                           TextTrimming="CharacterEllipsis" MaxWidth="140" />
                            </StackPanel>
                        </StackPanel>

                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Sign out"
                                Command="{Binding LogoutCommand}" Margin="8,0,0,0">
                            <materialDesign:PackIcon Kind="Logout" />
                        </Button>
                    </StackPanel>

                    <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="Pill" Width="28" Height="28"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="PharmaPOS" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding StoreCodeDisplay}" VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   FontSize="13" FontWeight="SemiBold"
                                   Opacity="0.95"
                                   TextTrimming="CharacterEllipsis" MaxWidth="160" />
                        <TextBlock Text="{Binding BranchName}" VerticalAlignment="Center"
                                   Opacity="0.75"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis" MaxWidth="160" />
                    </WrapPanel>
                </DockPanel>

                <!-- Module shortcuts (updates with selected tab) -->
                <ItemsControl ItemsSource="{Binding ActiveShortcuts}"
                              Margin="0,8,0,0"
                              Visibility="{Binding HasActiveShortcuts, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ShortcutHint}">
                            <Border Background="#33FFFFFF"
                                    BorderBrush="#55FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    Margin="0,0,8,4"
                                    ToolTip="{Binding Description}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#55FFFFFF"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Key}"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11"
                                               Opacity="0.95"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- Top navigation menu -->
        <materialDesign:Card Grid.Row="1" Margin="6,4,6,2" UniformCornerRadius="8"
                             materialDesign:ElevationAssist.Elevation="Dp2" Padding="4,2">
            <ListBox ItemsSource="{Binding MenuItems}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     Style="{StaticResource MaterialDesignNavigationPrimaryListBox}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     Padding="2,0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavigationItem}">
                        <StackPanel Orientation="Horizontal" Margin="8,6">
                            <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                     Width="18" Height="18"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Label}" Margin="8,0,4,0"
                                       VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </materialDesign:Card>

        <!-- Active content -->
        <ContentControl Grid.Row="2" Margin="6,2,6,6"
                        Content="{Binding CurrentViewModel}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
