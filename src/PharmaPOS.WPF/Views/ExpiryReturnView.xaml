<UserControl x:Class="PharmaPOS.WPF.Views.ExpiryReturnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:purchaseVm="clr-namespace:PharmaPOS.WPF.ViewModels.Purchases"
             d:DataContext="{d:DesignInstance Type=purchaseVm:ExpiryReturnViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760">
    <Grid Margin="4">
        <TabControl>
            <TabItem Header="Eligible batches">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Padding="8" UniformCornerRadius="10" Margin="0,0,0,4"
                                         ToolTip="Select near-expired or expired batches, set claim qty, then post. Stock leaves and supplier credit is opened until you attach their credit note. If Supplier is blank, pick the company in that column (opening stock / unmapped batches).">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Expiry to company" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="Window :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <ComboBox Width="160" Height="28"
                                          ItemsSource="{Binding HorizonOptions}"
                                          SelectedItem="{Binding SelectedHorizon}"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Window"
                                          materialDesign:HintAssist.IsFloating="False" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="Supplier :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <ComboBox Width="220" Height="28"
                                          ItemsSource="{Binding SupplierOptions}"
                                          SelectedValuePath="SupplierId"
                                          SelectedValue="{Binding SelectedSupplierId}"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Supplier"
                                          materialDesign:HintAssist.IsFloating="False" />
                            </StackPanel>
                            <Button Command="{Binding RefreshEligibleCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                                    ToolTip="Refresh">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                            </Button>
                            <Button Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,4,0"
                                    Content="Claim all stock" Padding="8,2" Height="28" />
                            <Button Command="{Binding ClearQtyCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Content="Clear qty" Padding="8,2" Height="28" />
                        </WrapPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Row="1" Padding="8" UniformCornerRadius="10">
                        <DataGrid ItemsSource="{Binding Batches}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Sel" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="44" />
                                <DataGridTextColumn Header="Medicine" Binding="{Binding Source.MedicineName}" Width="2*" MinWidth="140" IsReadOnly="True" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding Source.BatchNumber}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Expiry" Binding="{Binding Source.ExpiryDate, StringFormat=dd-MMM-yyyy}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Source.ExpiryStatus}" Width="110" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Supplier" Width="*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Suppliers}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding SupplierId, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="False"
                                                      MinWidth="140" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Bill" Binding="{Binding Source.PurchaseInvoiceNumber}" Width="110" IsReadOnly="True" />
                                <DataGridTextColumn Header="Stock" Binding="{Binding Source.StockQuantity, StringFormat=0.##}" Width="70" IsReadOnly="True" />
                                <DataGridTextColumn Header="Claim qty" Binding="{Binding ClaimQuantity, UpdateSourceTrigger=PropertyChanged}" Width="90" IsReadOnly="False" />
                                <DataGridTextColumn Header="Rate" Binding="{Binding Source.PurchasePrice, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="Claim value" Binding="{Binding ClaimValue, StringFormat=N2}" Width="90" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Row="2" Padding="8" UniformCornerRadius="10" Margin="0,4,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding SubmitClaimCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Padding="8,2" Height="28"
                                    Content="Submit claim (stock out)" />
                            <TextBlock DockPanel.Dock="Right" Margin="0,0,16,0" VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="{Binding ClaimTotal, StringFormat=Expected credit: {0:N2}}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Remarks :" Style="{StaticResource FieldCaption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBox MinWidth="200"
                                         materialDesign:HintAssist.Hint="Remarks (optional)"
                                         materialDesign:HintAssist.IsFloating="False"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </DockPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <TabItem Header="Claims / credit notes">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="280" />
                        <ColumnDefinition Width="1.2*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Margin="0,0,8,0" Padding="8" UniformCornerRadius="10">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="Posted claims" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Command="{Binding RefreshClaimsCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Width="28" Height="28" Padding="0" Margin="0,0,8,0"
                                        ToolTip="Refresh">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                                </Button>
                                <CheckBox Content="Awaiting credit note"
                                          IsChecked="{Binding AwaitingCreditOnly}" VerticalAlignment="Center" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Claims}"
                                      SelectedItem="{Binding SelectedClaim}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Claim #" Binding="{Binding ClaimNumber}" Width="130" />
                                    <DataGridTextColumn Header="Date" Binding="{Binding ClaimDate, StringFormat=dd-MMM-yyyy}" Width="100" />
                                    <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" MinWidth="120" />
                                    <DataGridTextColumn Header="Credit" Binding="{Binding ExpectedCreditAmount, StringFormat=N2}" Width="90" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" />
                                    <DataGridTextColumn Header="CN #" Binding="{Binding CreditNoteNumber}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" Padding="8" UniformCornerRadius="10"
                                         ToolTip="Select a claim to view claimed batches and attach the supplier credit note.">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Claim lines" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,2">
                                    <Run Text="{Binding ClaimDetail.ClaimNumber, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding ClaimDetail.SupplierName, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Opacity="0.7" Margin="0,0,0,4">
                                    <Run Text="Return " />
                                    <Run Text="{Binding ClaimDetail.ReturnNumber, Mode=OneWay}" />
                                    <Run Text=" · Expected " />
                                    <Run Text="{Binding ClaimDetail.ExpectedCreditAmount, Mode=OneWay, StringFormat=N2}" />
                                </TextBlock>
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ClaimDetail.Lines}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      Visibility="{Binding HasSelectedClaim, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="*" MinWidth="120" />
                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="90" />
                                    <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=dd-MMM-yyyy}" Width="95" />
                                    <DataGridTextColumn Header="Qty" Binding="{Binding ClaimQuantity, StringFormat=0.##}" Width="60" />
                                    <DataGridTextColumn Header="Rate" Binding="{Binding PurchasePrice, StringFormat=N2}" Width="70" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding LineTotal, StringFormat=N2}" Width="80" />
                                    <DataGridTextColumn Header="Bill" Binding="{Binding PurchaseInvoiceNumber}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="2" Margin="0,8,0,0"
                                        ToolTip="{Binding ManageBlockedReason}">
                                <TextBlock Text="Attach credit note" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding ManageBlockedReason}" Foreground="#C62828" FontSize="11"
                                           Margin="0,0,0,6" TextWrapping="Wrap"
                                           Visibility="{Binding HasManageBlockedReason, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="Credit note number" Style="{StaticResource FieldCaption}" Margin="0,0,0,2" />
                                <TextBox Margin="0,0,0,6"
                                         materialDesign:HintAssist.Hint="Credit note number"
                                         materialDesign:HintAssist.IsFloating="False"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding CreditNoteNumber, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Credit note date" Style="{StaticResource FieldCaption}" Margin="0,0,0,2" />
                                <DatePicker Margin="0,0,0,6"
                                            materialDesign:HintAssist.Hint="Credit note date"
                                            materialDesign:HintAssist.IsFloating="False"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            SelectedDate="{Binding CreditNoteDate}" />
                                <TextBlock Text="Credit amount" Style="{StaticResource FieldCaption}" Margin="0,0,0,2" />
                                <TextBox Margin="0,0,0,8"
                                         materialDesign:HintAssist.Hint="Credit amount (blank = expected)"
                                         materialDesign:HintAssist.IsFloating="False"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Text="{Binding CreditNoteAmount, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Command="{Binding AttachCreditNoteCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Content="Save credit note" Padding="8,2" Height="28"
                                        ToolTip="{Binding ManageBlockedReason}" />
                                <TextBlock Text="{Binding StatusMessage}" Opacity="0.6" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
