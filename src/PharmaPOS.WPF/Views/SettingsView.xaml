<UserControl x:Class="PharmaPOS.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:settingsVm="clr-namespace:PharmaPOS.WPF.ViewModels.Settings"
             d:DataContext="{d:DesignInstance Type=settingsVm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700">
    <UserControl.Resources>
        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            <Setter Property="materialDesign:HintAssist.Hint" Value="{x:Null}" />
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            <Setter Property="materialDesign:HintAssist.Hint" Value="{x:Null}" />
        </Style>
        <Style x:Key="FieldPassword" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            <Setter Property="materialDesign:HintAssist.Hint" Value="{x:Null}" />
        </Style>

        <!-- Mapping lists: stack original fields in fewer columns (auto row height — DataGrid RowHeight=28 was clipping). -->
        <Style x:Key="MappingFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="MappingFieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <DataTemplate x:Key="MappingMedicineListItemTemplate">
            <Border Padding="10,8" Margin="0,0,0,6"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="{StaticResource GridSelectionBrush}" />
                                <Setter Property="BorderBrush" Value="#4A90B8" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="140" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="110" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Name / Salt / Strength" FontSize="10" FontWeight="SemiBold"
                                   Opacity="0.5" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Style="{StaticResource MappingFieldLabel}" Text="Name" />
                            <TextBlock Style="{StaticResource MappingFieldValue}" Text="{Binding Name}" FontWeight="SemiBold" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Style="{StaticResource MappingFieldLabel}" Text="Salt" />
                            <TextBlock Style="{StaticResource MappingFieldValue}" Text="{Binding GenericName}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Style="{StaticResource MappingFieldLabel}" Text="Strength" />
                            <TextBlock Style="{StaticResource MappingFieldValue}" Text="{Binding Strength}" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Pack / Size / ID" FontSize="10" FontWeight="SemiBold"
                                   Opacity="0.5" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Style="{StaticResource MappingFieldLabel}" Text="Pack" />
                            <TextBlock Style="{StaticResource MappingFieldValue}" Text="{Binding PackInfo}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Style="{StaticResource MappingFieldLabel}" Text="Size" />
                            <TextBlock Style="{StaticResource MappingFieldValue}" Text="{Binding PackSize}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Style="{StaticResource MappingFieldLabel}" Text="ID" />
                            <TextBlock Style="{StaticResource MappingFieldValue}" Text="{Binding ExternalId}" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="MRP / Match" FontSize="10" FontWeight="SemiBold"
                                   Opacity="0.5" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource MappingFieldLabel}" Text="MRP" Width="40" />
                            <TextBlock Style="{StaticResource MappingFieldValue}"
                                       Text="{Binding Mrp, StringFormat=N2}" FontWeight="SemiBold" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Style="{StaticResource MappingFieldLabel}" Text="Match" Width="40" />
                            <CheckBox IsChecked="{Binding IsMatched}" IsEnabled="False"
                                      VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="MappingListBox" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>
        <!-- Transparent container so card Border can paint the sky-blue selection (MD grey overlay was covering it). -->
        <Style x:Key="MappingListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="8" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <materialDesign:Card UniformCornerRadius="12" Padding="16"
                             materialDesign:ElevationAssist.Elevation="Dp2"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

                <!-- Side nav: always lists MedWin Import when permitted (top tabs were clipping it on first layout). -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" MinWidth="120" />
                        <ColumnDefinition Width="*" MinWidth="240" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,12,0"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="0,0,1,0"
                            Padding="0,0,8,0">
                        <ListBox ItemsSource="{Binding Sections}"
                                 SelectedItem="{Binding SelectedSection}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type settingsVm:SettingsSection}">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="4,8" FontSize="13" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Headerless TabControl — selection driven by side list SelectedTab index -->
                    <TabControl Grid.Column="1"
                                SelectedIndex="{Binding SelectedTab, Mode=OneWay}"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                BorderThickness="0"
                                Padding="0"
                                Background="Transparent">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <ContentPresenter ContentSource="SelectedContent"
                                                  VerticalAlignment="Stretch"
                                                  HorizontalAlignment="Stretch" />
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </TabControl.ItemContainerStyle>
                    <!-- COMPANY -->
                    <TabItem Header="Company">
                        <ScrollViewer DataContext="{Binding Company}" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                <TextBlock Text="Company &amp; Store Details" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />

                                <TextBlock Text="Company Name *" Style="{StaticResource FieldCaption}" />
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding Editor.CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Legal Name" Style="{StaticResource FieldCaption}" />
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding Editor.LegalName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Address" Style="{StaticResource FieldCaption}" />
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding Editor.Address, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="City" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.City, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0">
                                        <TextBlock Text="State" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.State, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                        <TextBlock Text="Pincode" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.Pincode, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Phone" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.Phone, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Email" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.Email, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Website" Style="{StaticResource FieldCaption}" />
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding Editor.Website, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="GSTIN" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.GstNumber, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0">
                                        <TextBlock Text="Drug License" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.DrugLicenseNumber, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                        <TextBlock Text="PAN" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.Pan, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Logo file path" Style="{StaticResource FieldCaption}" />
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Command="{Binding BrowseLogoCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderOpen" VerticalAlignment="Center" />
                                            <TextBlock Text="Browse Logo" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding Editor.LogoPath, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                             IsReadOnly="True" />
                                </DockPanel>

                                <TextBlock Text="Invoice footer message" Style="{StaticResource FieldCaption}" />
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding Editor.InvoiceFooter, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Currency" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.Currency, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Currency Symbol" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                        <TextBlock Text="Save Company Profile" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,8,0,0"
                                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- BRANCHES -->
                    <TabItem Header="Branches">
                        <Grid DataContext="{Binding Branches}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.8*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}" ToolTip="Refresh" Margin="4,0,0,0">
                                        <materialDesign:PackIcon Kind="Refresh" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Command="{Binding NewCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                                            <TextBlock Text="New" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          MaxHeight="520" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="Auto" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="120" />
                                        <DataGridTextColumn Header="City" Binding="{Binding City}" Width="Auto" />
                                        <DataGridCheckBoxColumn Header="Head office" Binding="{Binding IsHeadOffice}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Code *" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Code, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Name *" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Address" Style="{StaticResource FieldCaption}" />
                                    <TextBox Style="{StaticResource FieldBox}"
                                             Text="{Binding Editor.Address, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="City" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.City, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0">
                                            <TextBlock Text="State" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.State, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock Text="Pincode" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Pincode, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Phone" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Phone, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Email" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Email, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="GSTIN" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.GstNumber, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Drug License" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.DrugLicenseNumber, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="Head Office" IsChecked="{Binding Editor.IsHeadOffice}" Margin="0,0,0,8" />
                                    <TextBlock Text="Status" Style="{StaticResource FieldCaption}" />
                                    <ComboBox Style="{StaticResource FieldCombo}"
                                              ItemsSource="{Binding EntityStatuses}" SelectedItem="{Binding Editor.Status}" />
                                    <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                            <TextBlock Text="Save Branch" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,8,0,0"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Counters">
                        <Grid DataContext="{Binding Counters}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.8*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}" ToolTip="Refresh" Margin="4,0,0,0">
                                        <materialDesign:PackIcon Kind="Refresh" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Command="{Binding NewCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                                            <TextBlock Text="New" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          MaxHeight="360" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="Auto" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="100" />
                                        <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault}" Width="Auto" />
                                        <DataGridTextColumn Header="Open by" Binding="{Binding OpenOperatorName}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Today's cash by counter" FontWeight="SemiBold" Margin="0,12,0,6" />
                                <Button Command="{Binding RefreshCashCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="Refresh cash" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding CashSummaryText}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Code *" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Code, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Name *" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="Default counter" Margin="0,8,0,8"
                                              IsChecked="{Binding Editor.IsDefault}" />
                                    <TextBlock Text="Status" Style="{StaticResource FieldCaption}" />
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              ItemsSource="{Binding EntityStatuses}"
                                              SelectedItem="{Binding Editor.Status}" Margin="0,0,0,12" />
                                    <Button Command="{Binding SaveCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            HorizontalAlignment="Left" Padding="16,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                            <TextBlock Text="Save Counter" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,8,0,0"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- PREFERENCES -->
                    <TabItem Header="Preferences">
                        <ScrollViewer DataContext="{Binding Preferences}" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,8,16">
                            <TextBlock Text="Inventory &amp; Billing Preferences" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                            <TextBlock Text="Near-expiry alert (days)" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding Editor.NearExpiryDays, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Default low-stock threshold" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding Editor.DefaultLowStockThreshold, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Sales invoice prefix" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding Editor.SalesInvoicePrefix, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Purchase invoice prefix" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding Editor.PurchaseInvoicePrefix, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Invoice numbers use the format PREFIX-yyyyMMdd-#### (resets daily)." Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="Bill editing" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,8" />
                            <CheckBox Content="Allow editing existing sale bills"
                                      IsChecked="{Binding Editor.AllowEditSalesBills}"
                                      Margin="0,0,0,8" />
                            <CheckBox Content="Allow editing existing purchase bills"
                                      IsChecked="{Binding Editor.AllowEditPurchaseBills}"
                                      Margin="0,0,0,4" />
                            <TextBlock Text="Master switch for invoice edits. When on, users still need Edit / Unlock permissions under Roles. Saved invoices lock automatically; unlock is required before changes."
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="AI bill scan (Gemini)" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,4" />
                            <TextBlock Text="Uses Google Gemini to read supplier bills of different formats. Get a free/paid API key from Google AI Studio. Key is stored only on this PC."
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox Content="Use Gemini for purchase bill scan"
                                      IsChecked="{Binding UseGemini}"
                                      Margin="0,0,0,8"
                                      FontWeight="SemiBold" />
                            <TextBlock Text="Must be checked (and API key saved) or Scan bill uses Windows OCR only."
                                       Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="Gemini API key" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Model" Style="{StaticResource FieldCaption}" />
                            <ComboBox Style="{StaticResource FieldCombo}"
                                      Margin="0,0,0,12"
                                      ItemsSource="{Binding GeminiModelOptions}"
                                      SelectedItem="{Binding GeminiModel}"
                                      IsEditable="True" />

                            <TextBlock Text="Send sale bill (WhatsApp / SMS)" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,4" />
                            <TextBlock Text="After save, ask to share the bill. With VPS upload enabled, the PDF is uploaded and WhatsApp/SMS includes a download link. Without VPS, WhatsApp falls back to manual PDF attach."
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox Content="Enable WhatsApp"
                                      IsChecked="{Binding EnableWhatsAppShare}"
                                      Margin="0,0,0,6" />
                            <CheckBox Content="Enable SMS"
                                      IsChecked="{Binding EnableSmsShare}"
                                      Margin="0,0,0,6" />
                            <CheckBox Content="Ask after saving a sale"
                                      IsChecked="{Binding AskShareAfterSave}"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="VPS bill PDF upload (SFTP)" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,4" />
                            <TextBlock Text="Upload each bill PDF, then put the public HTTPS link in WhatsApp. Public base URL must be the exact browser prefix where those files open — not the Linux folder path."
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="Example for your VPS: Public base URL http://bills.cloudpharma.site/bills/ (must open the PDF in a browser)."
                                       Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox Content="Upload bill PDF to VPS and share link"
                                      IsChecked="{Binding EnableVpsUpload}"
                                      Margin="0,0,0,8"
                                      FontWeight="SemiBold" />
                            <TextBlock Text="Public base URL (what you type in a browser)" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     materialDesign:HintAssist.Hint="https://yourdomain.com/bills/"
                                     Text="{Binding PublicBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Must start with https:// and end with the folder path that serves PDFs (usually ends with /bills/)."
                                       Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="SFTP host" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding SftpHost, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="SFTP port" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding SftpPort, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="SFTP username" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding SftpUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="SFTP password" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding SftpPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Remote folder on VPS (must be inside website public root)" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Margin="0,0,0,4"
                                     materialDesign:HintAssist.Hint="public_html/bills  or  /var/www/html/bills"
                                     Text="{Binding SftpRemoteDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Do NOT use a bare /bills path unless that folder is actually your web root. If the browser 404s, the SFTP folder is wrong — not the Public base URL."
                                       Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox Content="Shorten bill link with TinyURL (recommended for WhatsApp)"
                                      IsChecked="{Binding EnableTinyUrl}"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Online reporting sync (VPS MySQL)" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,4" />
                            <TextBlock Text="Queues sales, purchases, returns, stock and masters locally, then uploads to your MySQL reporting database in the background. POS never waits on the VPS."
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox Content="Enable MySQL reporting sync"
                                      IsChecked="{Binding EnableMySqlSync}"
                                      Margin="0,0,0,8"
                                      FontWeight="SemiBold" />
                            <TextBlock Text="MySQL host" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding MySqlHost, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Port" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding MySqlPort, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Database" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding MySqlDatabase, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Username" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding MySqlUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Password" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding MySqlPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Require SSL"
                                      IsChecked="{Binding MySqlUseSsl}"
                                      Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Command="{Binding TestMySqlConnectionCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Content="Test connection" />
                                <TextBlock Text="{Binding MySqlSyncStatusText}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="Store code (your choice)" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     IsReadOnly="True"
                                     FontWeight="SemiBold"
                                     Text="{Binding StoreIdentityCode, Mode=OneWay}" />
                            <TextBlock Text="Store ID (auto, used for online reporting)" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     Text="{Binding StoreIdentityId, Mode=OneWay}" />
                            <TextBlock Text="Store code is your display name. Store ID is system-generated and maps sales/purchases on the server. Both are locked to this PC after vendor approval."
                                       Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="Layout (this PC)" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,4" />
                            <TextBlock Text="Drag the splitter between grid and summary on Sales/Purchase, or resize grid column headers. Widths are saved automatically. You can also set summary panel widths here."
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="Sales summary panel width (px)" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding SalesSidePanelWidth, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Purchase summary panel width (px)" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding PurchaseSidePanelWidth, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding ResetLayoutCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    HorizontalAlignment="Left" Margin="0,4,0,12"
                                    Content="Reset layout to defaults" />

                            <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                    <TextBlock Text="Save Preferences" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,8,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- MEDICINE MAPPING -->
                    <TabItem Header="Medicine Mapping">
                        <Grid DataContext="{Binding MedicineMapping}" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding AutoMapCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                            IsEnabled="{Binding CanAutoMap}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AutoFix" VerticalAlignment="Center" />
                                            <TextBlock Text="Auto Map" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ShowQueueCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Content="{Binding PendingQueueLabel}" Margin="0,0,8,0" />
                                    <Button Command="{Binding ShowAppliedMappingsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Content="Applied Mappings" Margin="0,0,8,0" />
                                    <Button Command="{Binding ApplyMappingsCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                            IsEnabled="{Binding CanApplyMappings}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                            <TextBlock Text="Apply Mappings" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <CheckBox Content="Include already matched medicines"
                                              IsChecked="{Binding IncludeMatched}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Select a MedWin medicine on the left — Gemini picks the best OneMG match (name, formula, strength, packing) when enabled in Preferences. Click Map to queue, or use Auto Map for bulk rules. Review with View Queue, then Apply Mappings to save."
                                           Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Command="{Binding RefreshMedWinCommand}"
                                                Style="{StaticResource MaterialDesignIconButton}" ToolTip="Refresh" Margin="4,0,0,0">
                                            <materialDesign:PackIcon Kind="Refresh" />
                                        </Button>
                                        <TextBlock Text="MedWin Medicines (unmatched)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock Text="Filter MedWin medicines" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding MedWinSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <ListBox Grid.Row="2" x:Name="MedWinMappingGrid"
                                             ItemsSource="{Binding MedWinItems}"
                                             SelectedItem="{Binding SelectedMedWin, Mode=TwoWay}"
                                             Style="{StaticResource MappingListBox}"
                                             ItemContainerStyle="{StaticResource MappingListBoxItem}"
                                             ItemTemplate="{StaticResource MappingMedicineListItemTemplate}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                    <Button Command="{Binding MapCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                            IsEnabled="{Binding CanMap}" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="LinkVariant" VerticalAlignment="Center" />
                                            <TextBlock Text="Map" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Queues mapping (instant)" TextAlignment="Center" Opacity="0.5"
                                               FontSize="11" TextWrapping="Wrap" MaxWidth="90" />
                                </StackPanel>

                                <Grid Grid.Column="2" Margin="8,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="OneMG Catalogue" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock Text="Narrow OneMG matches" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding OneMgSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding OneMgItems}"
                                             SelectedItem="{Binding SelectedOneMg}"
                                             Style="{StaticResource MappingListBox}"
                                             ItemContainerStyle="{StaticResource MappingListBoxItem}"
                                             ItemTemplate="{StaticResource MappingMedicineListItemTemplate}" />
                                </Grid>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,12,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                        </Grid>
                    </TabItem>

                    <!-- MEDWIN IMPORT -->
                    <TabItem Header="MedWin Import"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch">
                        <!-- Log is docked bottom at a FIXED 300px so the global TextBox Height=30 style cannot collapse it.
                             Form scrolls in the remaining space above. -->
                        <DockPanel DataContext="{Binding MedWinImport}" Margin="0,8,0,0"
                                   LastChildFill="True" VerticalAlignment="Stretch">

                            <DockPanel DockPanel.Dock="Bottom" Height="300" Margin="0,10,0,0" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="Progress log" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Border BorderBrush="#BDBDBD"
                                        BorderThickness="1"
                                        Background="#FAFAFA"
                                        ClipToBounds="True">
                                    <ScrollViewer x:Name="MedWinImportLogScroll"
                                                  VerticalScrollBarVisibility="Visible"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False"
                                                  Padding="10">
                                        <!-- TextBlock (not TextBox): app-wide TextBox style forces Height/MaxHeight=30 -->
                                        <TextBlock Text="{Binding LogText, Mode=OneWay, NotifyOnTargetUpdated=True}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   TargetUpdated="MedWinImportLog_TargetUpdated" />
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Stretch">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Migrate MedWin Access data into this store's PharmaPOS database. Requires Microsoft ACE OLEDB 12.0. Backup LocalDB before wiping or Force re-import."
                                               Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,10" />

                                    <Border Background="#FFF8E1" BorderBrush="#FFCC80" BorderThickness="1" Padding="10" CornerRadius="6" Margin="0,0,0,10">
                                        <StackPanel>
                                            <CheckBox Content="Clear existing transactional data before import (recommended for fresh MedWin start)"
                                                      IsChecked="{Binding ClearExistingTransactionalData}"
                                                      FontWeight="SemiBold"
                                                      IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                                            <TextBlock Margin="24,4,0,0" Opacity="0.75" TextWrapping="Wrap" FontSize="12"
                                                       Text="Deletes all current sales, purchases, returns, payments, stock batches, and stock movements. Keeps medicine catalogue and other masters. Then imports MedWin masters + selected transactional phases. Requires two confirmations." />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="MedWin data.mdb path" Style="{StaticResource FieldCaption}" />
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Command="{Binding BrowseMdbCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Content="Browse…" Margin="8,0,0,0" Padding="12,0" />
                                        <TextBox Style="{StaticResource FieldBox}" Margin="0"
                                                 Text="{Binding MdbPath, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                                    </DockPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Jet OLEDB password" Style="{StaticResource FieldCaption}" />
                                            <PasswordBox Style="{StaticResource FieldPassword}"
                                                         materialDesign:PasswordBoxAssist.Password="{Binding MdbPassword, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Content="Force rematch medicines"
                                                  IsChecked="{Binding Force}" VerticalAlignment="Center" Margin="0,8,0,0"
                                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                                                  ToolTip="Rematch medicines to OneMG when the medicines phase runs. Clear-before-import already enables re-import of sales/purchases." />
                                    </Grid>

                                    <DockPanel Margin="0,4,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Command="{Binding SelectFullImportCommand}" Content="Select all phases"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"
                                                    ToolTip="Check every phase included in a full MedWin import" />
                                            <Button Command="{Binding SelectNoneCommand}" Content="Clear phases"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                                        </StackPanel>
                                        <TextBlock Text="Phases" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Phases}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                                          Margin="0,0,16,8"
                                                          IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBool}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Command="{Binding RunFullImportCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"
                                                ToolTip="Select all full-import phases and start the import">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="DatabaseImport" VerticalAlignment="Center" />
                                                <TextBlock Text="Full import" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding RunImportCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"
                                                Content="Run selected"
                                                ToolTip="Import only the phases currently checked" />
                                        <Button Command="{Binding CancelImportCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Content="Cancel" Margin="0,0,8,0" />
                                        <Button Command="{Binding ClearLogCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                                                Content="Clear log" />
                                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Foreground="#2E7D32"
                                                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- ROLES & PERMISSIONS -->
                    <TabItem Header="Roles &amp; Permissions">
                        <Grid DataContext="{Binding RolePermissions}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}" ToolTip="Refresh" Margin="4,0,0,0">
                                        <materialDesign:PackIcon Kind="Refresh" />
                                    </Button>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          MaxHeight="520" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Role" Binding="{Binding Name}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                                    <TextBlock Text="Grant module access for the selected role. Users must sign in again after changes."
                                               Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding ModuleGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding Module}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding Permissions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsGranted}"
                                                                          IsEnabled="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          Margin="0,2" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                                IsEnabled="{Binding CanManage}" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                                <TextBlock Text="Save Permissions" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ResetDefaultsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                                IsEnabled="{Binding CanManage}">
                                            <TextBlock Text="Reset to Defaults" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,8,0,0"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- USERS -->
                    <TabItem Header="Users">
                        <Grid DataContext="{Binding Users}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.8*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}" ToolTip="Refresh" Margin="4,0,0,0">
                                        <materialDesign:PackIcon Kind="Refresh" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Command="{Binding NewCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4,0,0,0"
                                            IsEnabled="{Binding CanManageUsers}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                                            <TextBlock Text="New" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="Search users" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          MaxHeight="520" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="Auto" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" MinWidth="120" />
                                        <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                                    <TextBlock Text="Username *" Style="{StaticResource FieldCaption}" />
                                    <TextBox Style="{StaticResource FieldBox}"
                                             Text="{Binding Editor.Username, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanManageUsers}" />
                                    <TextBlock Text="Full Name *" Style="{StaticResource FieldCaption}" />
                                    <TextBox Style="{StaticResource FieldBox}"
                                             Text="{Binding Editor.FullName, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanManageUsers}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Email" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Email, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanManageUsers}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Phone" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Phone, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanManageUsers}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Role *" Style="{StaticResource FieldCaption}" />
                                    <ComboBox Style="{StaticResource FieldCombo}"
                                              ItemsSource="{Binding Roles}" DisplayMemberPath="Name"
                                              SelectedValue="{Binding Editor.RoleId}" SelectedValuePath="Id"
                                              IsEnabled="{Binding CanManageUsers}" />
                                    <TextBlock Text="Branch" Style="{StaticResource FieldCaption}" />
                                    <ComboBox Style="{StaticResource FieldCombo}"
                                              ItemsSource="{Binding Branches}" DisplayMemberPath="Name"
                                              SelectedValue="{Binding Editor.BranchId}" SelectedValuePath="Id"
                                              IsEnabled="{Binding CanManageUsers}" />
                                    <TextBlock Text="Status" Style="{StaticResource FieldCaption}" />
                                    <ComboBox Style="{StaticResource FieldCombo}"
                                              ItemsSource="{Binding EntityStatuses}" SelectedItem="{Binding Editor.Status}"
                                              IsEnabled="{Binding CanManageUsers}" />
                                    <TextBlock Text="Password (required for new user)" Style="{StaticResource FieldCaption}" />
                                    <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource FieldPassword}"
                                                 IsEnabled="{Binding CanManageUsers}"
                                                 materialDesign:PasswordBoxAssist.Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Require password change on next login" IsChecked="{Binding Editor.MustChangePassword}"
                                              Margin="0,0,0,12" IsEnabled="{Binding CanManageUsers}" />
                                    <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                            HorizontalAlignment="Left" IsEnabled="{Binding CanManageUsers}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                            <TextBlock Text="Save User" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Separator Margin="0,16,0,12" Visibility="{Binding Editor.Id, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Visibility="{Binding Editor.Id, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Reset Password" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock Text="New password" Style="{StaticResource FieldCaption}" />
                                        <PasswordBox Style="{StaticResource FieldPassword}"
                                                     IsEnabled="{Binding CanManageUsers}"
                                                     materialDesign:PasswordBoxAssist.Password="{Binding ResetPassword, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Command="{Binding ResetPasswordCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                                HorizontalAlignment="Left" IsEnabled="{Binding CanManageUsers}">
                                            <TextBlock Text="Reset Password" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,8,0,0"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- MY PASSWORD -->
                    <TabItem Header="My Password">
                        <StackPanel DataContext="{Binding ChangePassword}" Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                            <TextBlock Text="Current password" Style="{StaticResource FieldCaption}" />
                            <PasswordBox Style="{StaticResource FieldPassword}"
                                         materialDesign:PasswordBoxAssist.Password="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="New password" Style="{StaticResource FieldCaption}" />
                            <PasswordBox Style="{StaticResource FieldPassword}"
                                         materialDesign:PasswordBoxAssist.Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Confirm new password" Style="{StaticResource FieldCaption}" />
                            <PasswordBox Style="{StaticResource FieldPassword}"
                                         materialDesign:PasswordBoxAssist.Password="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Key" VerticalAlignment="Center" />
                                    <TextBlock Text="Change Password" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,8,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </TabItem>

                    <!-- APPEARANCE -->
                    <TabItem Header="Appearance">
                        <StackPanel DataContext="{Binding Appearance}" Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding IsDarkMode}"
                                          Content="Dark mode"
                                          Margin="0,0,0,8" />
                            <TextBlock Text="Theme applies immediately. Preference is not persisted between sessions yet."
                                       Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>

                    <!-- BACKUP -->
                    <TabItem Header="Backup">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Backup}">
                            <StackPanel Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left">
                                <TextBlock Text="Database backup" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Margin="0,4,0,16" Opacity="0.7" TextWrapping="Wrap"
                                           Text="Manual backup saves a .bak file on this computer. Auto backup runs after data changes, at the interval you choose, and uploads to Google Drive when connected." />

                                <TextBlock Text="Manual backup" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Button Command="{Binding ManualBackupCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        HorizontalAlignment="Left" Padding="16,8" Margin="0,0,0,16">
                                    <TextBlock Text="Backup now…" />
                                </Button>

                                <TextBlock Text="Automatic backup" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <CheckBox IsChecked="{Binding AutoEnabled}" Content="Enable automatic backup"
                                          Margin="0,0,0,10" />
                                <TextBlock Text="How often (after data has changed)" Style="{StaticResource FieldCaption}" />
                                <ComboBox Style="{StaticResource FieldCombo}"
                                          ItemsSource="{Binding Frequencies}"
                                          SelectedItem="{Binding SelectedFrequency}"
                                          DisplayMemberPath="Label" />

                                <TextBlock Text="Google Drive (auto upload)" FontWeight="SemiBold" Margin="0,8,0,8" />
                                <TextBlock Margin="0,0,0,10" Opacity="0.7" TextWrapping="Wrap"
                                           Text="Google does not allow Gmail password for Drive. Create an OAuth Desktop client in Google Cloud, paste Client ID and Secret, then Connect. Files go to a folder named PharmaPOS Backups." />
                                <TextBlock Text="OAuth Client ID" Style="{StaticResource FieldCaption}" />
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding GoogleClientId, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="OAuth Client Secret" Style="{StaticResource FieldCaption}" />
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding GoogleClientSecret, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold"
                                           Text="{Binding GoogleAccountEmail, TargetNullValue='Not connected'}" />
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Command="{Binding ConnectGoogleCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,8,4" Padding="14,6">
                                        <TextBlock Text="Connect Google Drive" />
                                    </Button>
                                    <Button Command="{Binding DisconnectGoogleCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Margin="0,0,8,4" Padding="14,6">
                                        <TextBlock Text="Disconnect" />
                                    </Button>
                                    <Button Command="{Binding SaveSettingsCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Margin="0,0,0,4" Padding="14,6">
                                        <TextBlock Text="Save backup settings" />
                                    </Button>
                                </WrapPanel>

                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" TextWrapping="Wrap"
                                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SHOP UPDATES (vendor console only) -->
                    <TabItem Header="Shop updates">
                        <DockPanel DataContext="{Binding ShopUpdates}" Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Push a POS update to selected shops" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Margin="0,4,0,12" Opacity="0.7" TextWrapping="Wrap"
                                           Text="Publish the installer to the VPS, tick shops, then Send update. Each shop is prompted the next time PharmaPOS is open (1.2.0 or later)." />

                                <WrapPanel Margin="0,0,0,12">
                                    <StackPanel MinWidth="240" MaxWidth="420" Width="340" Margin="0,0,16,12">
                                        <TextBlock Text="1. Publish installer" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock Text="Version" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding PackageVersion, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Notes (optional)" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding PackageNotes, UpdateSourceTrigger=PropertyChanged}" />
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Command="{Binding BrowsePackageCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="8,0,0,0">
                                                <TextBlock Text="Browse…" />
                                            </Button>
                                            <TextBox Style="{StaticResource FieldBox}" Margin="0"
                                                     Text="{Binding SelectedPackagePath, Mode=OneWay}" IsReadOnly="True" />
                                        </DockPanel>
                                        <Button Command="{Binding PublishCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                HorizontalAlignment="Left" Padding="16,6">
                                            <TextBlock Text="Upload to server" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel MinWidth="240" MaxWidth="420" Width="340">
                                        <TextBlock Text="2. Send to shops" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock Text="Published version" Style="{StaticResource FieldCaption}" />
                                        <ComboBox Style="{StaticResource FieldCombo}"
                                                  ItemsSource="{Binding Releases}"
                                                  SelectedItem="{Binding SelectedRelease}"
                                                  DisplayMemberPath="Version" />
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Command="{Binding SelectAllCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,4">
                                                <TextBlock Text="Select all" />
                                            </Button>
                                            <Button Command="{Binding SelectNoneCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,4">
                                                <TextBlock Text="Select none" />
                                            </Button>
                                            <Button Command="{Binding RefreshCommand}"
                                                    Style="{StaticResource MaterialDesignIconButton}" ToolTip="Refresh">
                                                <materialDesign:PackIcon Kind="Refresh" />
                                            </Button>
                                        </WrapPanel>
                                        <Button Command="{Binding SendUpdateCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                HorizontalAlignment="Left" Padding="16,6">
                                            <TextBlock Text="Send update to selected shops" TextWrapping="Wrap" />
                                        </Button>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,0,0,8"
                                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>

            <DataGrid ItemsSource="{Binding Shops}" AutoGenerateColumns="False"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Shop" Binding="{Binding StoreCode}" Width="*" MinWidth="100" IsReadOnly="True" />
                                    <DataGridTextColumn Header="PC" Binding="{Binding MachineName}" Width="140" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Approved" Binding="{Binding Approved}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Installed" Binding="{Binding AppVersion}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="110" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Assignment" Binding="{Binding UpdateStatus}" Width="160" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    </TabControl>
                </Grid>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
