<UserControl x:Class="PharmaPOS.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:settingsVm="clr-namespace:PharmaPOS.WPF.ViewModels.Settings"
             d:DataContext="{d:DesignInstance Type=settingsVm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700">
    <UserControl.Resources>
        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            <Setter Property="materialDesign:HintAssist.Hint" Value="{x:Null}" />
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            <Setter Property="materialDesign:HintAssist.Hint" Value="{x:Null}" />
        </Style>
        <Style x:Key="FieldPassword" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            <Setter Property="materialDesign:HintAssist.Hint" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="8">
        <materialDesign:Card UniformCornerRadius="12" Padding="16"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

                <TabControl SelectedIndex="{Binding SelectedTab}">
                    <!-- COMPANY -->
                    <TabItem Header="Company" Visibility="{Binding CanManageCompany, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer DataContext="{Binding Company}" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                <TextBlock Text="Company &amp; Store Details" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />

                                <TextBlock Text="Company Name *" Style="{StaticResource FieldCaption}" />
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding Editor.CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Legal Name" Style="{StaticResource FieldCaption}" />
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding Editor.LegalName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Address" Style="{StaticResource FieldCaption}" />
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding Editor.Address, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="City" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.City, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0">
                                        <TextBlock Text="State" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.State, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                        <TextBlock Text="Pincode" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.Pincode, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Phone" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.Phone, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Email" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.Email, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Website" Style="{StaticResource FieldCaption}" />
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding Editor.Website, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="GSTIN" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.GstNumber, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0">
                                        <TextBlock Text="Drug License" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.DrugLicenseNumber, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                        <TextBlock Text="PAN" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.Pan, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Logo file path" Style="{StaticResource FieldCaption}" />
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Command="{Binding BrowseLogoCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderOpen" VerticalAlignment="Center" />
                                            <TextBlock Text="Browse Logo" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding Editor.LogoPath, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                             IsReadOnly="True" />
                                </DockPanel>

                                <TextBlock Text="Invoice footer message" Style="{StaticResource FieldCaption}" />
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding Editor.InvoiceFooter, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Currency" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.Currency, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Currency Symbol" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Editor.CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                        <TextBlock Text="Save Company Profile" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,8,0,0"
                                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- BRANCHES -->
                    <TabItem Header="Branches" Visibility="{Binding CanManageBranches, Converter={StaticResource BoolToVisibility}}">
                        <Grid DataContext="{Binding Branches}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.8*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}" ToolTip="Refresh" Margin="4,0,0,0">
                                        <materialDesign:PackIcon Kind="Refresh" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Command="{Binding NewCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                                            <TextBlock Text="New" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          MaxHeight="520" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="Auto" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="120" />
                                        <DataGridTextColumn Header="City" Binding="{Binding City}" Width="Auto" />
                                        <DataGridCheckBoxColumn Header="HO" Binding="{Binding IsHeadOffice}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Code *" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Code, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Name *" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Address" Style="{StaticResource FieldCaption}" />
                                    <TextBox Style="{StaticResource FieldBox}"
                                             Text="{Binding Editor.Address, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="City" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.City, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0">
                                            <TextBlock Text="State" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.State, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock Text="Pincode" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Pincode, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Phone" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Phone, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Email" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Email, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="GSTIN" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.GstNumber, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Drug License" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.DrugLicenseNumber, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="Head Office" IsChecked="{Binding Editor.IsHeadOffice}" Margin="0,0,0,8" />
                                    <TextBlock Text="Status" Style="{StaticResource FieldCaption}" />
                                    <ComboBox Style="{StaticResource FieldCombo}"
                                              ItemsSource="{Binding EntityStatuses}" SelectedItem="{Binding Editor.Status}" />
                                    <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                            <TextBlock Text="Save Branch" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,8,0,0"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- PREFERENCES -->
                    <TabItem Header="Preferences" Visibility="{Binding CanManagePreferences, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer DataContext="{Binding Preferences}" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,8,16">
                            <TextBlock Text="Inventory &amp; Billing Preferences" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                            <TextBlock Text="Near-expiry alert (days)" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding Editor.NearExpiryDays, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Default low-stock threshold" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding Editor.DefaultLowStockThreshold, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Sales invoice prefix" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding Editor.SalesInvoicePrefix, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Purchase invoice prefix" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding Editor.PurchaseInvoicePrefix, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Invoice numbers use the format PREFIX-yyyyMMdd-#### (resets daily)." Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="Bill editing" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,8" />
                            <CheckBox Content="Allow editing existing sale bills"
                                      IsChecked="{Binding Editor.AllowEditSalesBills}"
                                      Margin="0,0,0,8" />
                            <CheckBox Content="Allow editing existing purchase bills"
                                      IsChecked="{Binding Editor.AllowEditPurchaseBills}"
                                      Margin="0,0,0,4" />
                            <TextBlock Text="When off, opened bills are view-only (print / return still work for sales)."
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="AI bill scan (Gemini)" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,4" />
                            <TextBlock Text="Uses Google Gemini to read supplier bills of different formats. Get a free/paid API key from Google AI Studio. Key is stored only on this PC."
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox Content="Use Gemini for purchase bill scan"
                                      IsChecked="{Binding UseGemini}"
                                      Margin="0,0,0,8"
                                      FontWeight="SemiBold" />
                            <TextBlock Text="Must be checked (and API key saved) or Scan bill uses Windows OCR only."
                                       Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="Gemini API key" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Model" Style="{StaticResource FieldCaption}" />
                            <ComboBox Style="{StaticResource FieldCombo}"
                                      Margin="0,0,0,12"
                                      ItemsSource="{Binding GeminiModelOptions}"
                                      SelectedItem="{Binding GeminiModel}"
                                      IsEditable="True" />

                            <TextBlock Text="Send sale bill (WhatsApp / SMS)" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,4" />
                            <TextBlock Text="After save, ask to share the bill. With VPS upload enabled, the PDF is uploaded and WhatsApp/SMS includes a download link. Without VPS, WhatsApp falls back to manual PDF attach."
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox Content="Enable WhatsApp"
                                      IsChecked="{Binding EnableWhatsAppShare}"
                                      Margin="0,0,0,6" />
                            <CheckBox Content="Enable SMS"
                                      IsChecked="{Binding EnableSmsShare}"
                                      Margin="0,0,0,6" />
                            <CheckBox Content="Ask after saving a sale"
                                      IsChecked="{Binding AskShareAfterSave}"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="VPS bill PDF upload (SFTP)" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,4" />
                            <TextBlock Text="Upload each bill PDF, then put the public HTTPS link in WhatsApp. Public base URL must be the exact browser prefix where those files open — not the Linux folder path."
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="Example for your VPS: Public base URL http://bills.cloudpharma.site/bills/ (must open the PDF in a browser)."
                                       Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox Content="Upload bill PDF to VPS and share link"
                                      IsChecked="{Binding EnableVpsUpload}"
                                      Margin="0,0,0,8"
                                      FontWeight="SemiBold" />
                            <TextBlock Text="Public base URL (what you type in a browser)" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     materialDesign:HintAssist.Hint="https://yourdomain.com/bills/"
                                     Text="{Binding PublicBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Must start with https:// and end with the folder path that serves PDFs (usually ends with /bills/)."
                                       Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="SFTP host" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding SftpHost, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="SFTP port" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding SftpPort, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="SFTP username" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding SftpUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="SFTP password" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding SftpPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Remote folder on VPS (must be inside website public root)" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Margin="0,0,0,4"
                                     materialDesign:HintAssist.Hint="public_html/bills  or  /var/www/html/bills"
                                     Text="{Binding SftpRemoteDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Do NOT use a bare /bills path unless that folder is actually your web root. If the browser 404s, the SFTP folder is wrong — not the Public base URL."
                                       Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox Content="Shorten bill link with TinyURL (recommended for WhatsApp)"
                                      IsChecked="{Binding EnableTinyUrl}"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Layout (this PC)" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,4" />
                            <TextBlock Text="Drag the splitter between grid and summary on Sales/Purchase, or resize grid column headers. Widths are saved automatically. You can also set summary panel widths here."
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="Sales summary panel width (px)" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding SalesSidePanelWidth, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Purchase summary panel width (px)" Style="{StaticResource FieldCaption}" />
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding PurchaseSidePanelWidth, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding ResetLayoutCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    HorizontalAlignment="Left" Margin="0,4,0,12"
                                    Content="Reset layout to defaults" />

                            <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                    <TextBlock Text="Save Preferences" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,8,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- MEDICINE MAPPING -->
                    <TabItem Header="Medicine Mapping" Visibility="{Binding CanManageMedicineMapping, Converter={StaticResource BoolToVisibility}}">
                        <Grid DataContext="{Binding MedicineMapping}" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding AutoMapCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                            IsEnabled="{Binding CanAutoMap}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AutoFix" VerticalAlignment="Center" />
                                            <TextBlock Text="Auto Map" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ShowQueueCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Content="{Binding PendingQueueLabel}" Margin="0,0,8,0" />
                                    <Button Command="{Binding ShowAppliedMappingsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Content="Applied Mappings" Margin="0,0,8,0" />
                                    <Button Command="{Binding ApplyMappingsCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                            IsEnabled="{Binding CanApplyMappings}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                            <TextBlock Text="Apply Mappings" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <CheckBox Content="Include already matched medicines"
                                              IsChecked="{Binding IncludeMatched}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Select a MedWin medicine, pick the matching OneMG row, then click Map to queue — or use Auto Map to queue confident matches in bulk. Review with View Queue, then Apply Mappings to save."
                                           Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Command="{Binding RefreshMedWinCommand}"
                                                Style="{StaticResource MaterialDesignIconButton}" ToolTip="Refresh" Margin="4,0,0,0">
                                            <materialDesign:PackIcon Kind="Refresh" />
                                        </Button>
                                        <TextBlock Text="MedWin Medicines (unmatched)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock Text="Filter MedWin medicines" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding MedWinSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <DataGrid Grid.Row="2" x:Name="MedWinMappingGrid" ItemsSource="{Binding MedWinItems}"
                                              SelectedItem="{Binding SelectedMedWin, Mode=TwoWay}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              SelectionUnit="FullRow" HeadersVisibility="Column"
                                              ScrollViewer.CanContentScroll="False"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              VerticalAlignment="Stretch">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" />
                                            <DataGridTextColumn Header="Salt" Binding="{Binding GenericName}" Width="120" />
                                            <DataGridTextColumn Header="MedWin ID" Binding="{Binding ExternalId}" Width="80" />
                                            <DataGridCheckBoxColumn Header="Matched" Binding="{Binding IsMatched}" Width="70" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                    <Button Command="{Binding MapCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                            IsEnabled="{Binding CanMap}" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="LinkVariant" VerticalAlignment="Center" />
                                            <TextBlock Text="Map" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Queues mapping (instant)" TextAlignment="Center" Opacity="0.5"
                                               FontSize="11" TextWrapping="Wrap" MaxWidth="90" />
                                </StackPanel>

                                <Grid Grid.Column="2" Margin="8,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="OneMG Catalogue" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock Text="Narrow OneMG matches" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding OneMgSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <DataGrid Grid.Row="2" ItemsSource="{Binding OneMgItems}" SelectedItem="{Binding SelectedOneMg}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              ScrollViewer.CanContentScroll="False"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              VerticalAlignment="Stretch">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" />
                                            <DataGridTextColumn Header="Salt" Binding="{Binding GenericName}" Width="120" />
                                            <DataGridTextColumn Header="Pack" Binding="{Binding PackInfo}" Width="120" />
                                            <DataGridTextColumn Header="OneMG ID" Binding="{Binding ExternalId}" Width="80" />
                                            <DataGridCheckBoxColumn Header="Matched" Binding="{Binding IsMatched}" Width="70" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,12,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                        </Grid>
                    </TabItem>

                    <!-- ROLES & PERMISSIONS -->
                    <TabItem Header="Roles &amp; Permissions" Visibility="{Binding CanManageRoles, Converter={StaticResource BoolToVisibility}}">
                        <Grid DataContext="{Binding RolePermissions}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}" ToolTip="Refresh" Margin="4,0,0,0">
                                        <materialDesign:PackIcon Kind="Refresh" />
                                    </Button>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          MaxHeight="520" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Role" Binding="{Binding Name}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                                    <TextBlock Text="Grant module access for the selected role. Users must sign in again after changes."
                                               Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding ModuleGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding Module}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding Permissions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsGranted}"
                                                                          IsEnabled="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          Margin="0,2" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                                IsEnabled="{Binding CanManage}" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                                <TextBlock Text="Save Permissions" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ResetDefaultsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                                IsEnabled="{Binding CanManage}">
                                            <TextBlock Text="Reset to Defaults" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,8,0,0"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- USERS -->
                    <TabItem Header="Users" Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisibility}}">
                        <Grid DataContext="{Binding Users}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.8*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}" ToolTip="Refresh" Margin="4,0,0,0">
                                        <materialDesign:PackIcon Kind="Refresh" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Command="{Binding NewCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4,0,0,0"
                                            IsEnabled="{Binding CanManageUsers}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                                            <TextBlock Text="New" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="Search users" Style="{StaticResource FieldCaption}" />
                                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          MaxHeight="520" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="Auto" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" MinWidth="120" />
                                        <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                                    <TextBlock Text="Username *" Style="{StaticResource FieldCaption}" />
                                    <TextBox Style="{StaticResource FieldBox}"
                                             Text="{Binding Editor.Username, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanManageUsers}" />
                                    <TextBlock Text="Full Name *" Style="{StaticResource FieldCaption}" />
                                    <TextBox Style="{StaticResource FieldBox}"
                                             Text="{Binding Editor.FullName, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanManageUsers}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Email" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Email, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanManageUsers}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Phone" Style="{StaticResource FieldCaption}" />
                                            <TextBox Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.Phone, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanManageUsers}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Role *" Style="{StaticResource FieldCaption}" />
                                    <ComboBox Style="{StaticResource FieldCombo}"
                                              ItemsSource="{Binding Roles}" DisplayMemberPath="Name"
                                              SelectedValue="{Binding Editor.RoleId}" SelectedValuePath="Id"
                                              IsEnabled="{Binding CanManageUsers}" />
                                    <TextBlock Text="Branch" Style="{StaticResource FieldCaption}" />
                                    <ComboBox Style="{StaticResource FieldCombo}"
                                              ItemsSource="{Binding Branches}" DisplayMemberPath="Name"
                                              SelectedValue="{Binding Editor.BranchId}" SelectedValuePath="Id"
                                              IsEnabled="{Binding CanManageUsers}" />
                                    <TextBlock Text="Status" Style="{StaticResource FieldCaption}" />
                                    <ComboBox Style="{StaticResource FieldCombo}"
                                              ItemsSource="{Binding EntityStatuses}" SelectedItem="{Binding Editor.Status}"
                                              IsEnabled="{Binding CanManageUsers}" />
                                    <TextBlock Text="Password (required for new user)" Style="{StaticResource FieldCaption}" />
                                    <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource FieldPassword}"
                                                 IsEnabled="{Binding CanManageUsers}"
                                                 materialDesign:PasswordBoxAssist.Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Require password change on next login" IsChecked="{Binding Editor.MustChangePassword}"
                                              Margin="0,0,0,12" IsEnabled="{Binding CanManageUsers}" />
                                    <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                            HorizontalAlignment="Left" IsEnabled="{Binding CanManageUsers}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" />
                                            <TextBlock Text="Save User" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Separator Margin="0,16,0,12" Visibility="{Binding Editor.Id, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Visibility="{Binding Editor.Id, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Reset Password" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock Text="New password" Style="{StaticResource FieldCaption}" />
                                        <PasswordBox Style="{StaticResource FieldPassword}"
                                                     IsEnabled="{Binding CanManageUsers}"
                                                     materialDesign:PasswordBoxAssist.Password="{Binding ResetPassword, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Command="{Binding ResetPasswordCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                                HorizontalAlignment="Left" IsEnabled="{Binding CanManageUsers}">
                                            <TextBlock Text="Reset Password" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,8,0,0"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- MY PASSWORD -->
                    <TabItem Header="My Password">
                        <StackPanel DataContext="{Binding ChangePassword}" Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                            <TextBlock Text="Current password" Style="{StaticResource FieldCaption}" />
                            <PasswordBox Style="{StaticResource FieldPassword}"
                                         materialDesign:PasswordBoxAssist.Password="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="New password" Style="{StaticResource FieldCaption}" />
                            <PasswordBox Style="{StaticResource FieldPassword}"
                                         materialDesign:PasswordBoxAssist.Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Confirm new password" Style="{StaticResource FieldCaption}" />
                            <PasswordBox Style="{StaticResource FieldPassword}"
                                         materialDesign:PasswordBoxAssist.Password="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Key" VerticalAlignment="Center" />
                                    <TextBlock Text="Change Password" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" Margin="0,8,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </TabItem>

                    <!-- APPEARANCE -->
                    <TabItem Header="Appearance">
                        <StackPanel DataContext="{Binding Appearance}" Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding IsDarkMode}"
                                          Content="Dark mode"
                                          Margin="0,0,0,8" />
                            <TextBlock Text="Theme applies immediately. Preference is not persisted between sessions yet."
                                       Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
