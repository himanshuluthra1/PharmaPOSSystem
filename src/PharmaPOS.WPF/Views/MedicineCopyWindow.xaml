<Window x:Class="PharmaPOS.WPF.Views.MedicineCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Copy medicine"
        Height="560" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Copy medicine" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"
                   Text="Pick an existing medicine to copy, edit Name / Salt / Brand / MRP / GST, then save as a new medicine master." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="Save to master" Style="{StaticResource MaterialDesignRaisedButton}"
                    IsEnabled="False" Click="SaveButton_Click" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Copy from" Style="{StaticResource FieldCaption}" />
                <DockPanel Margin="0,2,0,6">
                    <Button DockPanel.Dock="Right" x:Name="LoadButton" Content="Load"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="8,0,0,0" Padding="12,2" Height="28"
                            Click="LoadButton_Click"
                            ToolTip="Load selected medicine into the fields below" />
                    <TextBox x:Name="SourceSearchBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Search existing medicine"
                             materialDesign:HintAssist.IsFloating="False"
                             Text="{Binding SourceSearchText, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <ListBox x:Name="SourceList" MaxHeight="140" Margin="0,0,0,12"
                         DisplayMemberPath="Display"
                         MouseDoubleClick="SourceList_MouseDoubleClick" />

                <TextBlock Text="Review / edit before save" FontWeight="SemiBold" Margin="0,4,0,8" />

                <TextBlock Text="Name *" Style="{StaticResource FieldCaption}" />
                <TextBox x:Name="NameBox" Margin="0,2,0,8" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.IsFloating="False" />

                <TextBlock Text="Generic / salt" Style="{StaticResource FieldCaption}" />
                <TextBox x:Name="GenericBox" Margin="0,2,0,8" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.IsFloating="False" />

                <TextBlock Text="Brand (company)" Style="{StaticResource FieldCaption}" />
                <TextBox x:Name="BrandBox" Margin="0,2,0,8" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.IsFloating="False" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MRP" Style="{StaticResource FieldCaption}" />
                        <TextBox x:Name="MrpBox" Margin="0,2,0,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.IsFloating="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="GST %" Style="{StaticResource FieldCaption}" />
                        <TextBox x:Name="GstBox" Text="12" Margin="0,2,0,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.IsFloating="False" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#E65100" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
