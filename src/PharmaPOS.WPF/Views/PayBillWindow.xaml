<Window x:Class="PharmaPOS.WPF.Views.PayBillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Title}"
        Width="480"
        MinHeight="520"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" />
            <TextBlock Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap"
                       Text="{Binding Subtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding Party.Name}" />
                <TextBlock Opacity="0.75" Margin="0,2,0,10"
                           Text="{Binding Party.Phone, TargetNullValue='No mobile on file'}" />

                <Border Padding="10" Margin="0,0,0,12" CornerRadius="4"
                        Background="{DynamicResource MaterialDesignToolBarBackground}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Invoice" Style="{StaticResource FieldCaption}" />
                            <TextBlock Text="{Binding Bill.InvoiceNumber}" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Supplier Bill #" Style="{StaticResource FieldCaption}" />
                            <TextBlock Text="{Binding Bill.SupplierBillNumber, TargetNullValue=—}" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Date" Style="{StaticResource FieldCaption}" />
                            <TextBlock Text="{Binding Bill.InvoiceDateLabel}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Balance due" Style="{StaticResource FieldCaption}" />
                            <TextBlock Text="{Binding Bill.BalanceDue, StringFormat=N2}"
                                       FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="{Binding AmountLabel}" Style="{StaticResource FieldCaption}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Full amount"
                            Command="{Binding PayFullCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Padding="8,0"
                            FontSize="11" />
                </DockPanel>
                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{Binding AccountLabel}" Style="{StaticResource FieldCaption}" Margin="0,10,0,2" />
                <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          ItemsSource="{Binding CashBankAccounts}"
                          SelectedItem="{Binding SelectedAccount}"
                          DisplayMemberPath="DisplayLabel" />

                <TextBlock Text="Notes (optional)" Style="{StaticResource FieldCaption}" Margin="0,10,0,2" />
                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Foreground="#D32F2F" TextWrapping="Wrap" Margin="0,8,0,8"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Padding="14,6" Height="32" />
            <Button Content="{Binding ConfirmLabel}" Command="{Binding PayCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Padding="16,6" Height="32" />
        </StackPanel>
    </Grid>
</Window>
