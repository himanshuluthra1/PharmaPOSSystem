<Window x:Class="PharmaPOS.WPF.Views.CollectDueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Collect now" Height="420" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Collect dues" FontSize="20" FontWeight="Bold" />
            <TextBlock Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap"
                       Text="Record cash/bank receipt against this customer's outstanding balance." />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock FontWeight="SemiBold" Text="{Binding Customer.Name}" />
            <TextBlock Opacity="0.75" Margin="0,2,0,10"
                       Text="{Binding Customer.Phone, TargetNullValue='No mobile on file'}" />
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="Outstanding" Opacity="0.7" />
                <TextBlock Text="{Binding Customer.OutstandingBalance, Converter={StaticResource Currency}}"
                           HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="16" />
            </DockPanel>

            <TextBlock Text="Amount to collect" FontSize="11" Opacity="0.7" Margin="0,0,0,2" />
            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Receive in" FontSize="11" Opacity="0.7" Margin="0,10,0,2" />
            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      ItemsSource="{Binding CashBankAccounts}"
                      SelectedItem="{Binding SelectedAccount}"
                      DisplayMemberPath="DisplayLabel" />

            <TextBlock Text="Notes (optional)" FontSize="11" Opacity="0.7" Margin="0,10,0,2" />
            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <TextBlock Grid.Row="2" Foreground="#D32F2F" TextWrapping="Wrap" Margin="0,8,0,8"
                   Text="{Binding ErrorMessage}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Padding="14,8" />
            <Button Content="Collect &amp; print" Command="{Binding CollectCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Padding="16,8" />
        </StackPanel>
    </Grid>
</Window>
