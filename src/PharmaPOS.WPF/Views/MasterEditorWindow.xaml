                    <TextBox Grid.Column="3" Style="{StaticResource FieldBox}" MaxLength="8" Margin="0,1,0,1"
                             behaviors:TextBoxLimits.DigitsOnly="True"
                             Text="{Binding Editor.HsnCode, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mfr :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" Margin="0,1,0,1"
                              ItemsSource="{Binding Manufacturers}"
                              SelectedItem="{Binding SelectedManufacturer}"
                              DisplayMemberPath="Name" />
                </Grid>
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Barcode :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" MaxLength="64"
                             Text="{Binding Editor.Barcode, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding GenerateBarcodeCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="26" Height="26" Padding="2" Margin="0,0,2,0" ToolTip="Generate">
                            <materialDesign:PackIcon Kind="Barcode" Width="12" Height="12" />
                        </Button>
                        <Button Command="{Binding PreviewBarcodeCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="26" Height="26" Padding="2" Margin="0,0,2,0" ToolTip="Print">
                            <materialDesign:PackIcon Kind="Printer" Width="12" Height="12" />
                        </Button>
                        <Button Command="{Binding ScanBarcodeCameraCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="26" Height="26" Padding="2" Margin="0,0,2,0" ToolTip="Camera">
                            <materialDesign:PackIcon Kind="Camera" Width="12" Height="12" />
                        </Button>
                        <Button Command="{Binding ScanBarcodeImageCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="26" Height="26" Padding="2" ToolTip="Image">
                            <materialDesign:PackIcon Kind="Image" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Purchase :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Editor.PurchasePrice, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="MRP :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="3" Style="{StaticResource FieldBox}"
                             Text="{Binding Editor.Mrp, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4" Text="Sell :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="5" Style="{StaticResource FieldBox}" Margin="0,1,0,1"
                             Text="{Binding Editor.SellingPrice, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GST% :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Editor.GstPercent, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="Disc% :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="3" Style="{StaticResource FieldBox}"
                             Text="{Binding Editor.DefaultDiscountPercent, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4" Text="Reorder :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="5" Style="{StaticResource FieldBox}" Margin="0,1,0,1"
                             Text="{Binding Editor.ReorderLevel, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Rack :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" MaxLength="20"
                             Text="{Binding Editor.RackNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="Bin :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="3" Style="{StaticResource FieldBox}" MaxLength="20"
                             Text="{Binding Editor.BinNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4" Text="Sch :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <ComboBox Grid.Column="5" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding ScheduleDrugTypes}" SelectedItem="{Binding Editor.ScheduleType}" />
                    <TextBlock Grid.Column="6" Text="Status :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <ComboBox Grid.Column="7" Style="{StaticResource FieldCombo}" Margin="0,1,0,1"
                              ItemsSource="{Binding EntityStatuses}" SelectedItem="{Binding Editor.Status}" />
                </Grid>
                <CheckBox Content="Prescription required" IsChecked="{Binding Editor.PrescriptionRequired}"
                          Margin="76,6,0,0" FontSize="11" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" Foreground="#2E7D32" FontSize="11"
                       VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
            <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Height="30" Padding="16,2" IsDefault="True" />
            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="12,2" Margin="0,0,8,0" IsCancel="True" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding EditorTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
        <ContentControl Content="{Binding}" />
    </DockPanel>
</Window>
