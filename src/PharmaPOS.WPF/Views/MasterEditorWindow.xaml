<Window x:Class="PharmaPOS.WPF.Views.MasterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mastersVm="clr-namespace:PharmaPOS.WPF.ViewModels.Masters"
        xmlns:behaviors="clr-namespace:PharmaPOS.WPF.Behaviors"
        Title="{Binding EditorTitle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="520"
        MaxWidth="640"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Margin" Value="0,1,6,1" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MaxHeight" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="materialDesign:TextFieldAssist.TextBoxViewMargin" Value="0" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Margin" Value="0,1,6,1" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MaxHeight" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        </Style>

        <!-- SUPPLIER -->
        <DataTemplate DataType="{x:Type mastersVm:SupplierTabViewModel}">
            <StackPanel Width="480" Margin="4">
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name * :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" MaxLength="50"
                             Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="Phone :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="3" Style="{StaticResource FieldBox}" MaxLength="12" Margin="0,1,0,1"
                             behaviors:TextBoxLimits.DigitsOnly="True"
                             Text="{Binding Editor.Phone, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GST No :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" MaxLength="15"
                             Text="{Binding Editor.GstNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="Lic :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="3" Style="{StaticResource FieldBox}" MaxLength="30" Margin="0,1,0,1"
                             Text="{Binding Editor.DrugLicenseNumber, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Contact :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" MaxLength="50"
                             Text="{Binding Editor.ContactPerson, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="Days :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="3" Style="{StaticResource FieldBox}" MaxLength="3" Margin="0,1,0,1"
                             behaviors:TextBoxLimits.DigitsOnly="True"
                             Text="{Binding Editor.PaymentTermsDays, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Email :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" MaxLength="100" Margin="0,1,0,1"
                             Text="{Binding Editor.Email, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Address :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" MaxLength="200" Margin="0,1,0,1"
                             Text="{Binding Editor.Address, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="City :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" MaxLength="50"
                             Text="{Binding Editor.City, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="State :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="3" Style="{StaticResource FieldBox}" MaxLength="50"
                             Text="{Binding Editor.State, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4" Text="Pin :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <TextBox Grid.Column="5" Style="{StaticResource FieldBox}" MaxLength="6" Margin="0,1,0,1"
                             behaviors:TextBoxLimits.DigitsOnly="True"
                             Text="{Binding Editor.Pincode, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Status :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" Margin="0,1,0,1"
                              ItemsSource="{Binding EntityStatuses}" SelectedItem="{Binding Editor.Status}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

