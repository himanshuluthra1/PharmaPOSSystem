                    <TextBlock Grid.Column="4" Text="Status :" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    <ComboBox Grid.Column="5" Style="{StaticResource FieldCombo}" Margin="0,1,0,1"
                              ItemsSource="{Binding EntityStatuses}" SelectedItem="{Binding Editor.Status}" />
                </Grid>
            </StackPanel>
