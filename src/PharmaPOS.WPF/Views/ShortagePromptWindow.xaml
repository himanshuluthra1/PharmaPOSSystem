<Window x:Class="PharmaPOS.WPF.Views.ShortagePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Shortage book"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Wanted quantity (optional)" Style="{StaticResource FieldCaption}" />
            <TextBox x:Name="QuantityBox"
                     Margin="0,4,0,0"
                     FontSize="15"
                     Padding="8,6"
                     materialDesign:HintAssist.Hint="Leave blank to use default" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Customer name (optional)" Style="{StaticResource FieldCaption}" />
            <TextBox x:Name="CustomerBox"
                     Margin="0,4,0,0"
                     FontSize="15"
                     Padding="8,6"
                     materialDesign:HintAssist.Hint="Who asked for this medicine?" />
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="ErrorText" Margin="0,10,0,0"
                   Foreground="#C62828" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" Padding="16,8"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    IsCancel="True"
                    Click="Cancel_Click" />
            <Button Content="Record" Padding="16,8"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    IsDefault="True"
                    Click="Record_Click" />
        </StackPanel>
    </Grid>
</Window>
