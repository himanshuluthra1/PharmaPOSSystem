<Window x:Class="PharmaPOS.WPF.Views.MedicineDetailPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Medicine Details" Height="480" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Medicine Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Medicine Name :" Style="{StaticResource FieldCaption}"
                       VerticalAlignment="Center" Margin="0,0,8,10" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MedicineName}" TextWrapping="Wrap"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Brand :" Style="{StaticResource FieldCaption}"
                       VerticalAlignment="Center" Margin="0,0,8,10" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Brand, TargetNullValue=-, FallbackValue=-}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,10" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Salt :" Style="{StaticResource FieldCaption}"
                       VerticalAlignment="Center" Margin="0,0,8,10" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Salt, TargetNullValue=-, FallbackValue=-}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,10" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Schedule :" Style="{StaticResource FieldCaption}"
                       VerticalAlignment="Center" Margin="0,0,8,10" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ScheduleLabel, FallbackValue=-}"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,0,10" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Qty Available :" Style="{StaticResource FieldCaption}"
                       VerticalAlignment="Center" Margin="0,0,8,10" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding QuantityAvailable, StringFormat=0.##}"
                       VerticalAlignment="Center" Margin="0,0,0,10" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Cost Price :" Style="{StaticResource FieldCaption}"
                       VerticalAlignment="Center" Margin="0,0,8,10" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CostPrice, StringFormat=N2}"
                       VerticalAlignment="Center" Margin="0,0,0,10" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="MRP :" Style="{StaticResource FieldCaption}"
                       VerticalAlignment="Center" Margin="0,0,8,10" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Mrp, StringFormat=N2}"
                       VerticalAlignment="Center" Margin="0,0,0,10" />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Location :" Style="{StaticResource FieldCaption}"
                       VerticalAlignment="Center" Margin="0,0,8,10" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Location, TargetNullValue=-, FallbackValue=-}"
                       VerticalAlignment="Center" Margin="0,0,0,10" />

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Packing Size :" Style="{StaticResource FieldCaption}"
                       VerticalAlignment="Center" Margin="0,0,8,10" />
            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding PackingSize}"
                       VerticalAlignment="Center" Margin="0,0,0,10" />

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Packing Type :" Style="{StaticResource FieldCaption}"
                       VerticalAlignment="Center" Margin="0,0,8,10" />
            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding PackingType}"
                       VerticalAlignment="Center" Margin="0,0,0,10" />

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Strength :" Style="{StaticResource FieldCaption}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Strength, TargetNullValue=-, FallbackValue=-}"
                       VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Text="Esc or F4 to close" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="11" />
            <Button Content="Close" Style="{StaticResource MaterialDesignRaisedButton}" IsDefault="True" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
