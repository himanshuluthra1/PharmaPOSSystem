<Window x:Class="PharmaPOS.WPF.Views.InvoicePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Invoice Preview" Height="820" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource MaterialDesignToolBarBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Paper" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.75" />
                    <ComboBox x:Name="PaperSizeBox" Width="180"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectionChanged="PaperSizeBox_SelectionChanged"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,12,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PrintButton" Click="PrintButton_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" VerticalAlignment="Center" />
                            <TextBlock Text="Print" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PdfButton" Click="PdfButton_Click" Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="Download invoice as PDF">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" />
                            <TextBlock Text="Download" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Content="Cancel" Click="CloseButton_Click" IsCancel="True"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Background="#EEEEEE">
            <FlowDocumentPageViewer x:Name="Viewer" Margin="16" Zoom="90" />
        </Border>
    </DockPanel>
</Window>
