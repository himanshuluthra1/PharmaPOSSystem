<Window x:Class="PharmaPOS.WPF.Views.LastSaleRefillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Last sale / Refill" Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Last sale / Refill" FontSize="20" FontWeight="Bold" />
            <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="{Binding HeaderText}" />
        </StackPanel>

        <TextBox x:Name="SearchBox" Grid.Row="1"
                 materialDesign:HintAssist.Hint="Patient name or mobile"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8" />

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="Matching patients (latest bill)"
                       FontSize="11" Opacity="0.6" Margin="0,0,0,4" />
            <ListBox x:Name="MatchList"
                     ItemsSource="{Binding Matches}"
                     SelectedItem="{Binding SelectedMatch}"
                     DisplayMemberPath="DisplayLabel"
                     MouseDoubleClick="MatchList_MouseDoubleClick" />
        </DockPanel>

        <TextBlock Grid.Row="3" Margin="0,10,0,4" FontWeight="SemiBold"
                   Text="{Binding Refill.PatientName, TargetNullValue=''}"
                   Visibility="{Binding HasRefill, Converter={StaticResource BoolToVisibility}}" />

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Lines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="False"
                  Visibility="{Binding HasRefill, Converter={StaticResource BoolToVisibility}}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36" />
                <DataGridTextColumn Header="Medicine" Binding="{Binding Line.MedicineName}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Last qty" Binding="{Binding Line.LastQuantity, StringFormat=0.##}" Width="70" IsReadOnly="True" />
                <DataGridTextColumn Header="Refill qty" Binding="{Binding RefillQty, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" Width="80" />
                <DataGridTextColumn Header="Stock / batch" Binding="{Binding Line.StockLabel}" Width="150" IsReadOnly="True" />
                <DataGridTemplateColumn Header="" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add" Command="{Binding AddCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Padding="8,2"
                                        IsEnabled="{Binding Line.HasStock}" />
                                <Button Content="Shortage" Command="{Binding LogShortageCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Padding="8,2"
                                        ToolTip="Record lost sale in shortage book"
                                        Visibility="{Binding ShowShortageAction, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" Opacity="0.75"
                       TextWrapping="Wrap" MaxWidth="420" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Padding="14,8" />
                <Button Content="Add selected to cart" Command="{Binding AddAllCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" Padding="16,8" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
