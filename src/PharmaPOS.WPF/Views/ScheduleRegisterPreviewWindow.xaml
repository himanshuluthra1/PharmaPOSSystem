<Window x:Class="PharmaPOS.WPF.Views.ScheduleRegisterPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Schedule register preview" Height="720" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <DockPanel>
        <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryMid" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Click="PrintButton_Click"
                        Style="{StaticResource MaterialDesignRaisedLightButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Printer" VerticalAlignment="Center" />
                        <TextBlock Text="Print" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Click="PdfButton_Click" Margin="8,0,0,0"
                        Style="{StaticResource MaterialDesignRaisedLightButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" />
                        <TextBlock Text="Save PDF" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Content="Close" Margin="8,0,0,0" Click="CloseButton_Click"
                        Style="{StaticResource MaterialDesignFlatButton}" />
            </StackPanel>
        </materialDesign:ColorZone>
        <Border Background="#EEEEEE">
            <FlowDocumentPageViewer x:Name="Viewer" Margin="12" Zoom="85" />
        </Border>
    </DockPanel>
</Window>
