<Window x:Class="PharmaPOS.WPF.Views.CounterSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:PharmaPOS.WPF.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:CounterSelectViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="460" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Assets/app.ico"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding WindowTitle}" FontSize="22" FontWeight="Bold" />
            <TextBlock Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap"
                       Text="{Binding InstructionText}" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Counters}"
                  SelectedItem="{Binding SelectedCounter, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  MouseDoubleClick="CountersGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="70" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault}" Width="70" />
                <DataGridTextColumn Header="Open by" Binding="{Binding OpenOperatorName}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Opacity="0.8"
                       Text="Opening float (cash already in drawer)" />
            <TextBox Grid.Column="1"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding OpeningFloat, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Left" Foreground="#D32F2F" TextWrapping="Wrap"
                       Text="{Binding ErrorMessage}" VerticalAlignment="Center"
                       MaxWidth="280" />
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Content="{Binding ConfirmButtonText}"
                    Command="{Binding OpenCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="20,10" />
        </DockPanel>
    </Grid>
</Window>
