<Window x:Class="PharmaPOS.WPF.Views.MedicineSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Search Medicine" Height="720" Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="900" MinHeight="560"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Search Medicine" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

        <TextBox x:Name="SearchBox" Grid.Row="1"
                 materialDesign:HintAssist.Hint="Type medicine name (min 2 chars)"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="SearchBox_PreviewKeyDown"
                 Margin="0,0,0,8" />

        <Grid Grid.Row="2">
            <TextBlock Text="{Binding Hint}" FontSize="12" Opacity="0.7"
                       Margin="0,0,0,6" VerticalAlignment="Top"
                       Visibility="{Binding Hint, Converter={StaticResource StringToVisibility}}" />
            <DataGrid x:Name="ResultsList" Margin="0,22,0,0"
                      ItemsSource="{Binding Results}"
                      SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Focusable="True"
                      PreviewKeyDown="ResultsList_PreviewKeyDown"
                      MouseDoubleClick="ResultsList_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Brand / Name" Binding="{Binding Name}" Width="2*" MinWidth="160" />
                    <DataGridTextColumn Header="Salt" Binding="{Binding GenericName}" Width="*" MinWidth="120" />
                    <DataGridTextColumn Header="Location" Binding="{Binding LocationLabel}" Width="90" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding TotalStock, StringFormat=0.##}" Width="70" />
                    <DataGridTextColumn Header="Sch" Binding="{Binding ScheduleLabel}" Width="50" />
                    <DataGridTextColumn Header="Pack" Binding="{Binding PackLabel}" Width="100" />
                    <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=N2}" Width="80" />
                    <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}" Width="80" />
                    <DataGridTextColumn Header="HSN" Binding="{Binding HsnCode}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="CopyMedicineButton" Content="Copy Medicine"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0" Click="CopyMedicineButton_Click"
                        ToolTip="Copy an existing medicine, edit details, and save as a new master" />
                <Button x:Name="CreateFromWebButton" Content="Create from website"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="CreateFromWebButton_Click"
                        ToolTip="Download medicine details from 1MG / Apollo / Pharmeasy / TrueMeds / NetMeds and save to master" />
            </StackPanel>
            <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" IsCancel="True" />
                    <Button Content="Select" Style="{StaticResource MaterialDesignRaisedButton}"
                            IsDefault="True" Click="SelectButton_Click" />
                </StackPanel>
                <TextBlock Text="↑↓ navigate  •  Enter select  •  Ctrl+L ledger  •  Esc cancel"
                           Opacity="0.5" VerticalAlignment="Center" FontSize="11" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
