<UserControl x:Class="PharmaPOS.WPF.Views.MastersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mastersVm="clr-namespace:PharmaPOS.WPF.ViewModels.Masters"
             d:DataContext="{d:DesignInstance Type=mastersVm:MastersViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700">
    <UserControl.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Width" Value="240" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MaxHeight" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="materialDesign:TextFieldAssist.TextBoxViewMargin" Value="0" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        </Style>
        <Style x:Key="MasterListGrid" TargetType="DataGrid" BasedOn="{StaticResource PharmaDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="4,1" />
        </Style>
        <Style x:Key="GridActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinWidth" Value="52" />
        </Style>
        <DataTemplate x:Key="MasterActionsTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Edit" Style="{StaticResource GridActionButton}"
                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Button Content="Delete" Style="{StaticResource GridActionButton}" Margin="0"
                        Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="6">
        <materialDesign:Card UniformCornerRadius="8" Padding="10"
                             materialDesign:ElevationAssist.Elevation="Dp1">
            <TabControl SelectedIndex="{Binding SelectedTab}" Style="{StaticResource HeaderlessTabControl}">

                <TabItem Header="Suppliers">
                    <DockPanel DataContext="{Binding Suppliers}" Margin="0,4,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
                            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                            </Button>
                            <Button DockPanel.Dock="Right" Command="{Binding NewCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="10,0" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="New" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Search :" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SearchBox}" MaxLength="50"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" FontSize="11"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                        </DockPanel>
                        <DataGrid Style="{StaticResource MasterListGrid}"
                                  ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="140" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*" MinWidth="90" />
                                <DataGridTextColumn Header="GST" Binding="{Binding GstNumber}" Width="*" MinWidth="110" />
                                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="*" MinWidth="80" />
                                <DataGridTemplateColumn Header="Actions" Width="130" MinWidth="120"
                                                        CellTemplate="{StaticResource MasterActionsTemplate}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Customers">
                    <DockPanel DataContext="{Binding Customers}" Margin="0,4,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
                            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                            </Button>
                            <Button DockPanel.Dock="Right" Command="{Binding NewCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="10,0" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="New" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Search :" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SearchBox}" MaxLength="50"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" FontSize="11"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                        </DockPanel>
                        <DataGrid Style="{StaticResource MasterListGrid}"
                                  ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="140" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*" MinWidth="90" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" MinWidth="80" />
                                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="*" MinWidth="80" />
                                <DataGridTemplateColumn Header="Actions" Width="130" MinWidth="120"
                                                        CellTemplate="{StaticResource MasterActionsTemplate}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Doctors">
                    <DockPanel DataContext="{Binding Doctors}" Margin="0,4,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
                            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                            </Button>
                            <Button DockPanel.Dock="Right" Command="{Binding NewCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="10,0" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="New" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Search :" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SearchBox}" MaxLength="50"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" FontSize="11"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                        </DockPanel>
                        <DataGrid Style="{StaticResource MasterListGrid}"
                                  ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="140" />
                                <DataGridTextColumn Header="Specialization" Binding="{Binding Specialization}" Width="*" MinWidth="110" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*" MinWidth="90" />
                                <DataGridTextColumn Header="Hospital" Binding="{Binding Hospital}" Width="*" MinWidth="100" />
                                <DataGridTemplateColumn Header="Actions" Width="130" MinWidth="120"
                                                        CellTemplate="{StaticResource MasterActionsTemplate}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Manufacturers">
                    <DockPanel DataContext="{Binding Manufacturers}" Margin="0,4,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
                            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                            </Button>
                            <Button DockPanel.Dock="Right" Command="{Binding NewCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="10,0" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="New" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Search :" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SearchBox}" MaxLength="50"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" FontSize="11"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                        </DockPanel>
                        <DataGrid Style="{StaticResource MasterListGrid}"
                                  ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="140" />
                                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="*" MinWidth="80" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*" MinWidth="90" />
                                <DataGridTextColumn Header="GST" Binding="{Binding GstNumber}" Width="*" MinWidth="110" />
                                <DataGridTemplateColumn Header="Actions" Width="130" MinWidth="120"
                                                        CellTemplate="{StaticResource MasterActionsTemplate}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Employees">
                    <DockPanel DataContext="{Binding Employees}" Margin="0,4,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
                            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                            </Button>
                            <Button DockPanel.Dock="Right" Command="{Binding NewCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="10,0" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="New" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Search :" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource SearchBox}" MaxLength="50"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" FontSize="11"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                        </DockPanel>
                        <DataGrid Style="{StaticResource MasterListGrid}"
                                  ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="*" MinWidth="70" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="140" />
                                <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="*" MinWidth="100" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*" MinWidth="90" />
                                <DataGridTemplateColumn Header="Actions" Width="130" MinWidth="120"
                                                        CellTemplate="{StaticResource MasterActionsTemplate}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Medicines">
                    <DockPanel DataContext="{Binding Medicines}" Margin="0,4,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
                            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                            </Button>
                            <Button DockPanel.Dock="Right" Command="{Binding NewCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="10,0" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="New" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Search :" Style="{StaticResource FormLabel}" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource SearchBox}" MaxLength="50"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding SearchHint}" FontSize="11" Opacity="0.65" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding SearchHint, Converter={StaticResource StringToVisibility}}" />
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" FontSize="11"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </DockPanel>
                        <DataGrid Style="{StaticResource MasterListGrid}"
                                  ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="140" />
                                <DataGridTextColumn Header="Generic" Binding="{Binding GenericName}" Width="*" MinWidth="100" />
                                <DataGridTextColumn Header="Rack/Bin" Binding="{Binding LocationLabel}" Width="*" MinWidth="70" />
                                <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}" Width="70" />
                                <DataGridTemplateColumn Header="Actions" Width="130" MinWidth="120"
                                                        CellTemplate="{StaticResource MasterActionsTemplate}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </materialDesign:Card>
    </Grid>
</UserControl>
