<Window x:Class="PharmaPOS.WPF.Views.PurchaseBillScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Review scanned purchase bill" Height="780" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Review scanned purchase bill" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Verify supplier, invoice details and item matches. Unmatched items will not be added. Then apply to the Purchase tab and save."
                           TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" MaxWidth="900" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Apply to Purchase" Click="ApplyButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"
                        Foreground="White" />
                <Button Content="Cancel" Click="CancelButton_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="WarningText" DockPanel.Dock="Top" Foreground="#E65100"
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Text="Scanned image" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="BillImage" Stretch="Uniform" MaxHeight="640" />
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Supplier" FontSize="11" Opacity="0.7" />
                        <TextBox x:Name="SupplierBox" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Supplier invoice no." FontSize="11" Opacity="0.7" />
                        <TextBox x:Name="InvoiceNoBox" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Invoice date" FontSize="11" Opacity="0.7" />
                        <DatePicker x:Name="InvoiceDatePicker" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="Detected lines — click Pick to link each OCR item to a medicine in your master"
                           FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
                <DataGrid x:Name="LinesGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="OCR item (from bill)" Binding="{Binding OcrItemName}" Width="1.4*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Matched medicine" Binding="{Binding MatchedMedicineName}" Width="1.2*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Pick" Padding="6,2" Margin="2,0"
                                            Click="PickMedicine_Click"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            ToolTip="Choose medicine from your master catalog" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=dd/MM/yyyy, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                        <DataGridTextColumn Header="Cost" Binding="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="70" />
                        <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="70" />
                        <DataGridTextColumn Header="GST%" Binding="{Binding GstPercent, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                        <DataGridTextColumn Header="OK" Binding="{Binding MatchStatus}" Width="50" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
