<Window x:Class="PharmaPOS.WPF.Views.DocumentCameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Capture bill" Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CaptureButton" Content="Capture" Click="CaptureButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0" />
                <Button Content="Cancel" Click="CancelButton_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Opacity="0.75" />
        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
            <Image x:Name="PreviewImage" Stretch="Uniform" />
        </Border>
    </DockPanel>
</Window>
