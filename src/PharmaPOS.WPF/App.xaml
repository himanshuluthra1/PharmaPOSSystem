<Application x:Class="PharmaPOS.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:PharmaPOS.WPF.ViewModels"
             xmlns:salesVm="clr-namespace:PharmaPOS.WPF.ViewModels.Sales"
             xmlns:purchaseVm="clr-namespace:PharmaPOS.WPF.ViewModels.Purchases"
             xmlns:mastersVm="clr-namespace:PharmaPOS.WPF.ViewModels.Masters"
             xmlns:invVm="clr-namespace:PharmaPOS.WPF.ViewModels.Inventory"
             xmlns:acctVm="clr-namespace:PharmaPOS.WPF.ViewModels.Accounting"
             xmlns:repVm="clr-namespace:PharmaPOS.WPF.ViewModels.Reports"
             xmlns:settingsVm="clr-namespace:PharmaPOS.WPF.ViewModels.Settings"
             xmlns:conv="clr-namespace:PharmaPOS.WPF.Converters"
             xmlns:views="clr-namespace:PharmaPOS.WPF.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Teal"
                                             SecondaryColor="Amber"
                                             ColorAdjustment="{materialDesign:ColorAdjustment}" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:CurrencyConverter x:Key="Currency" />

            <!-- Match Sales bill-dropdown selection (default ListBox highlight ≈ sky blue). -->
            <SolidColorBrush x:Key="GridSelectionBrush" Color="#87CEEB" />
            <SolidColorBrush x:Key="GridSelectionForegroundBrush" Color="#1A1A1A" />

            <!-- Keyboard-focus highlight (distinct from selection blue) — used app-wide. -->
            <SolidColorBrush x:Key="FocusHighlightBrush" Color="#FFF3E0" />
            <SolidColorBrush x:Key="FocusBorderBrush" Color="#EF6C00" />
            <SolidColorBrush x:Key="FocusGridCellBrush" Color="#FFE0B2" />

            <Style x:Key="FocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="-3"
                                       StrokeThickness="2"
                                       Stroke="{StaticResource FocusBorderBrush}"
                                       StrokeDashArray="1 0"
                                       SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact outlined inputs — floating labels disabled so height matches text. -->
            <Style x:Key="MaterialDesignOutlinedTextBox" TargetType="TextBox"
                   BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="MaxHeight" Value="30" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.45" />
                <Setter Property="materialDesign:TextFieldAssist.TextBoxViewMargin" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Background" Value="{StaticResource FocusHighlightBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource FocusBorderBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MaterialDesignOutlinedComboBox" TargetType="ComboBox"
                   BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="MaxHeight" Value="30" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.45" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Background" Value="{StaticResource FocusHighlightBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource FocusBorderBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MaterialDesignOutlinedDatePicker" TargetType="DatePicker"
                   BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="MaxHeight" Value="30" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.45" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Background" Value="{StaticResource FocusHighlightBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}" />

            <!-- Implicit styles so local/page fields without an explicit key still highlight. -->
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}" />
            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}" />
            <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="MaxHeight" Value="30" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Background" Value="{StaticResource FocusHighlightBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource FocusBorderBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Compact grids app-wide with sky-blue selected row (same feel as bill dropdown). -->
            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource GridSelectionBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource GridSelectionForegroundBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Style.Triggers>
                    <!-- Row/cell selection stays subtle; only the focused cell gets the strong amber. -->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource GridSelectionBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource GridSelectionForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Background" Value="{StaticResource FocusGridCellBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Foreground" Value="{StaticResource GridSelectionForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsEditing" Value="True">
                        <Setter Property="Background" Value="{StaticResource FocusHighlightBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
                <Setter Property="RowHeight" Value="28" />
                <Setter Property="ColumnHeaderHeight" Value="34" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="6,2" />
                <Setter Property="materialDesign:DataGridAssist.ColumnHeaderPadding" Value="8,6" />
            </Style>

            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="Height" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- DataGridTextColumn defaults to TwoWay; read-only columns must be OneWay. -->
            <Style TargetType="{x:Type DataGridTextColumn}">
                <Setter Property="IsReadOnly" Value="True" />
            </Style>

            <!-- View-model to view mappings used by the shell content host. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type salesVm:SalesViewModel}">
                <views:SalesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type salesVm:SaleReturnViewModel}">
                <views:SaleReturnView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type purchaseVm:PurchaseViewModel}">
                <views:PurchaseView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type purchaseVm:PurchaseReturnViewModel}">
                <views:PurchaseReturnView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type invVm:InventoryViewModel}">
                <views:InventoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type mastersVm:MastersViewModel}">
                <views:MastersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type acctVm:AccountingViewModel}">
                <views:AccountingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type repVm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type settingsVm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
