<Application x:Class="PharmaPOS.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:PharmaPOS.WPF.ViewModels"
             xmlns:salesVm="clr-namespace:PharmaPOS.WPF.ViewModels.Sales"
             xmlns:purchaseVm="clr-namespace:PharmaPOS.WPF.ViewModels.Purchases"
             xmlns:mastersVm="clr-namespace:PharmaPOS.WPF.ViewModels.Masters"
             xmlns:invVm="clr-namespace:PharmaPOS.WPF.ViewModels.Inventory"
             xmlns:acctVm="clr-namespace:PharmaPOS.WPF.ViewModels.Accounting"
             xmlns:repVm="clr-namespace:PharmaPOS.WPF.ViewModels.Reports"
             xmlns:settingsVm="clr-namespace:PharmaPOS.WPF.ViewModels.Settings"
             xmlns:conv="clr-namespace:PharmaPOS.WPF.Converters"
             xmlns:views="clr-namespace:PharmaPOS.WPF.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Teal"
                                             SecondaryColor="Amber"
                                             ColorAdjustment="{materialDesign:ColorAdjustment}" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:CurrencyConverter x:Key="Currency" />

            <!-- Match Sales bill-dropdown selection (default ListBox highlight = sky blue). -->
            <SolidColorBrush x:Key="GridSelectionBrush" Color="#87CEEB" />
            <SolidColorBrush x:Key="GridSelectionForegroundBrush" Color="#1A1A1A" />

            <!-- App-wide DataGrid palette: bold teal headers + light readable row tones. -->
            <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#00695C" />
            <SolidColorBrush x:Key="GridHeaderForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="GridHeaderBorderBrush" Color="#004D40" />
            <SolidColorBrush x:Key="GridRowBackgroundBrush" Color="#E0F2F1" />
            <SolidColorBrush x:Key="GridAlternatingRowBackgroundBrush" Color="#FFF8E1" />
            <SolidColorBrush x:Key="GridLineBrush" Color="#B2DFDB" />

            <!-- Focused field fill (no border ring) — light green. -->
            <SolidColorBrush x:Key="FocusHighlightBrush" Color="#C8E6C9" />
            <SolidColorBrush x:Key="FocusBorderBrush" Color="#43A047" />
            <SolidColorBrush x:Key="FocusGridCellBrush" Color="#C8E6C9" />

            <!-- Idle fill for text inputs; focused fields use TextBoxFocusBackgroundBrush. -->
            <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#FFF9C4" />
            <SolidColorBrush x:Key="TextBoxFocusBackgroundBrush" Color="#C8E6C9" />
            <SolidColorBrush x:Key="FieldCaptionForegroundBrush" Color="#212121" />

            <!-- No dashed/outline focus ring — focus is shown by control fill color only. -->
            <Style x:Key="FocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle StrokeThickness="0" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Field labels above text boxes (Customer name, Phone, etc.). -->
            <Style x:Key="PharmaFieldCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource FieldCaptionForegroundBrush}" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style x:Key="FieldCaption" TargetType="TextBlock" BasedOn="{StaticResource PharmaFieldCaption}" />

            <!-- Content-only TabControl: headers come from the top submenu / green app bar. -->
            <Style x:Key="HeaderlessTabControl" TargetType="TabControl">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter ContentSource="SelectedContent"
                                              VerticalAlignment="Stretch"
                                              HorizontalAlignment="Stretch" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="TabItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Outlined inputs: floating HintAssist.Hint is the field label (stays visible when filled).
                 Forms that use a separate FieldCaption / FormLabel TextBlock should set IsFloating=False
                 and leave Hint empty to avoid double labels. -->
            <!-- Compact single-line inputs: match Sales (Height 28). Labels stay outside —
                 use FieldCaption on the left; do not float Hint over the field. -->
            <sys:Double x:Key="CompactInputHeight">28</sys:Double>

            <Style x:Key="MaterialDesignOutlinedTextBox" TargetType="TextBox"
                   BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Height" Value="{StaticResource CompactInputHeight}" />
                <Setter Property="MinHeight" Value="{StaticResource CompactInputHeight}" />
                <Setter Property="MaxHeight" Value="{StaticResource CompactInputHeight}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource TextBoxBackgroundBrush}" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="{x:Null}" />
                <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.9" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{StaticResource FieldCaptionForegroundBrush}" />
                <Setter Property="materialDesign:TextFieldAssist.TextBoxViewMargin" Value="0" />
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource TextBoxFocusBackgroundBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <Trigger Property="AcceptsReturn" Value="True">
                        <Setter Property="Height" Value="{x:Static sys:Double.NaN}" />
                        <Setter Property="MinHeight" Value="56" />
                        <Setter Property="MaxHeight" Value="160" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Background" Value="{StaticResource TextBoxFocusBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Background" Value="#FFFDE7" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#FFFDE7" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MaterialDesignOutlinedComboBox" TargetType="ComboBox"
                   BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Height" Value="{StaticResource CompactInputHeight}" />
                <Setter Property="MinHeight" Value="{StaticResource CompactInputHeight}" />
                <Setter Property="MaxHeight" Value="{StaticResource CompactInputHeight}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource TextBoxBackgroundBrush}" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="{x:Null}" />
                <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.9" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{StaticResource FieldCaptionForegroundBrush}" />
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource TextBoxFocusBackgroundBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Background" Value="{StaticResource TextBoxFocusBackgroundBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MaterialDesignOutlinedDatePicker" TargetType="DatePicker"
                   BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Height" Value="{StaticResource CompactInputHeight}" />
                <Setter Property="MinHeight" Value="{StaticResource CompactInputHeight}" />
                <Setter Property="MaxHeight" Value="{StaticResource CompactInputHeight}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource TextBoxBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="{x:Null}" />
                <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.9" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{StaticResource FieldCaptionForegroundBrush}" />
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource TextBoxFocusBackgroundBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="materialDesign:TransitionAssist.DisableTransitions" Value="True" />
                <!-- No green focus fill — it covers the date text in MD's template. -->
            </Style>

            <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}" />

            <Style TargetType="DatePickerTextBox">
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesignBody}" />
            </Style>

            <!-- Replace MD keyed PasswordBox so Style="{StaticResource MaterialDesignOutlinedPasswordBox}" is compact too. -->
            <Style x:Key="MaterialDesignOutlinedPasswordBox" TargetType="PasswordBox"
                   BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Height" Value="{StaticResource CompactInputHeight}" />
                <Setter Property="MinHeight" Value="{StaticResource CompactInputHeight}" />
                <Setter Property="MaxHeight" Value="{StaticResource CompactInputHeight}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource TextBoxBackgroundBrush}" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="{x:Null}" />
                <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.9" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{StaticResource FieldCaptionForegroundBrush}" />
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource TextBoxFocusBackgroundBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Background" Value="{StaticResource TextBoxFocusBackgroundBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Implicit styles so local/page fields without an explicit key still highlight. -->
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}" />
            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}" />
            <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}" />

            <!-- Column-edge grippers so users can drag to resize (required named parts). -->
            <Style x:Key="PharmaColumnHeaderGripper" TargetType="Thumb">
                <Setter Property="Width" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="SizeWE" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact grids app-wide with sky-blue selected row (same feel as bill dropdown). -->
            <Style x:Key="PharmaDataGridColumnHeader" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="Height" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{StaticResource GridHeaderBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource GridHeaderForegroundBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="BorderBrush" Value="{StaticResource GridHeaderBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid SnapsToDevicePixels="True">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      RecognizesAccessKey="True"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                                <Thumb x:Name="PART_LeftHeaderGripper"
                                       HorizontalAlignment="Left"
                                       Style="{StaticResource PharmaColumnHeaderGripper}" />
                                <Thumb x:Name="PART_RightHeaderGripper"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource PharmaColumnHeaderGripper}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                     MaxHeight="22">
                                <TextBlock Text="{Binding}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource GridHeaderForegroundBrush}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="None" />
                            </Viewbox>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource PharmaDataGridColumnHeader}" />

            <Style x:Key="PharmaDataGridRow" TargetType="DataGridRow"
                   BasedOn="{StaticResource MaterialDesignDataGridRow}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource GridSelectionBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource GridSelectionForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#B2DFDB" />
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True" />
                            <Condition Property="IsSelected" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource GridSelectionBrush}" />
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridRow" BasedOn="{StaticResource PharmaDataGridRow}" />

            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
                <Style.Triggers>
                    <!-- Row/cell selection stays subtle; only the focused cell gets the strong amber. -->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource GridSelectionBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource GridSelectionForegroundBrush}" />
                        <Setter Property="BorderBrush" Value="#9E9E9E" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Background" Value="{StaticResource FocusGridCellBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource GridSelectionForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsEditing" Value="True">
                        <Setter Property="Background" Value="{StaticResource TextBoxFocusBackgroundBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource GridSelectionForegroundBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PharmaDataGrid" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
                <Setter Property="RowHeight" Value="28" />
                <Setter Property="ColumnHeaderHeight" Value="34" />
                <Setter Property="CanUserResizeColumns" Value="True" />
                <Setter Property="CanUserReorderColumns" Value="False" />
                <Setter Property="GridLinesVisibility" Value="All" />
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}" />
                <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GridLineBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GridHeaderBackgroundBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{StaticResource GridRowBackgroundBrush}" />
                <Setter Property="RowBackground" Value="{StaticResource GridRowBackgroundBrush}" />
                <Setter Property="AlternatingRowBackground" Value="{StaticResource GridAlternatingRowBackgroundBrush}" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource PharmaDataGridColumnHeader}" />
                <Setter Property="RowStyle" Value="{StaticResource PharmaDataGridRow}" />
                <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="6,2" />
                <Setter Property="materialDesign:DataGridAssist.ColumnHeaderPadding" Value="8,6" />
            </Style>

            <Style TargetType="DataGrid" BasedOn="{StaticResource PharmaDataGrid}" />

            <!-- DataGridTextColumn defaults to TwoWay; read-only columns must be OneWay. -->
            <Style TargetType="{x:Type DataGridTextColumn}">
                <Setter Property="IsReadOnly" Value="True" />
            </Style>

            <!-- View-model to view mappings used by the shell content host. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type salesVm:SalesViewModel}">
                <views:SalesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type salesVm:SaleReturnViewModel}">
                <views:SaleReturnView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type purchaseVm:PurchaseViewModel}">
                <views:PurchaseView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type purchaseVm:PurchaseOrderViewModel}">
                <views:PurchaseOrderView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type purchaseVm:PurchaseReturnViewModel}">
                <views:PurchaseReturnView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type purchaseVm:ExpiryReturnViewModel}">
                <views:ExpiryReturnView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type invVm:InventoryViewModel}">
                <views:InventoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type mastersVm:MastersViewModel}">
                <views:MastersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type acctVm:AccountingViewModel}">
                <views:AccountingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type repVm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type settingsVm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
